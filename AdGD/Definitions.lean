import Optlib.Function.Lsmooth
import Optlib.Convex.ConvexFunction
import Optlib.Differential.Lemmas
import Mathlib.Tactic
import Mathlib.Algebra.BigOperators.Group.Finset.Defs
import Mathlib.Analysis.Calculus.LocalExtr.Basic
import Mathlib.Topology.Compactness.Compact
import Mathlib.Topology.Bases
import Mathlib.Topology.MetricSpace.ProperSpace
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-!
# Adaptive Gradient Descent without Descent

Formalization of Algorithm 1, Lemma 1, and Theorem 1 from
Malitsky & Mishchenko, "Adaptive Gradient Descent without Descent", ICML 2020.
-/

noncomputable section AdGD_section

open Set InnerProductSpace

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
  [FiniteDimensional ℝ E]

variable {f : E → ℝ} {f' : E → E}

/-- θ_k = la_k / la_{k-1} for k ≥ 1. -/
def theta (la : ℕ → ℝ) (k : ℕ) : ℝ :=
  if k = 0 then 0 else la k / la (k - 1)

/-- The adaptive gradient descent algorithm.

The sequence (x_k) is generated by x_{k+1} = x_k - la_k • ∇f(x_k).

The stepsize la_k satisfies two conditions for k ≥ 1:
1. Don't increase too fast: la_k² ≤ (1 + θ_{k-1}) la_{k-1}²
2. Don't overstep local curvature: 2 la_k ‖∇f(x_k) - ∇f(x_{k-1})‖ ≤ ‖x_k - x_{k-1}‖
-/
structure AdGD (f : E → ℝ) (f' : E → E) where
  x : ℕ → E
  la : ℕ → ℝ
  la_pos : ∀ k, la k > 0
  update : ∀ k, x (k + 1) = x k - la k • f' (x k)
  diff : ∀ z, HasGradientAt f (f' z) z
  convex : ConvexOn ℝ Set.univ f
  stepsize_curvature : ∀ k ≥ 1,
    2 * la k * ‖f' (x k) - f' (x (k - 1))‖ ≤ ‖x k - x (k - 1)‖
  stepsize_growth : ∀ k ≥ 2,
    la k ^ 2 ≤ (1 + theta la (k - 1)) * la (k - 1) ^ 2

variable {alg : AdGD f f'}

set_option linter.unusedSectionVars false in
/-- For k ≥ 1, θ_k = la_k / la_{k-1}. -/
lemma algTheta_def (k : ℕ) (hk : k ≥ 1) :
    theta alg.la k = alg.la k / alg.la (k - 1) := by
  unfold theta; rw [if_neg (by omega)]

/-- Key consequence: la_{k+1} * θ_{k+1} ≤ (1 + θ_k) * la_k for k ≥ 1.
This means w_i = la_i(1+θ_i) - la_{i+1}θ_{i+1} ≥ 0.
-/
lemma theta_growth_bound (k : ℕ) (hk : k ≥ 1) :
    alg.la (k + 1) * theta alg.la (k + 1) ≤ (1 + theta alg.la k) * alg.la k := by
  have hk1 : k + 1 ≥ 2 := by omega
  have hcond := alg.stepsize_growth (k + 1) hk1
  -- Simplify k+1-1 = k in hcond
  have hksub : k + 1 - 1 = k := by omega
  rw [hksub] at hcond
  -- Rewrite theta in hcond and target
  rw [algTheta_def k hk] at hcond
  rw [algTheta_def (k + 1) (by omega), hksub, algTheta_def k hk]
  -- Now:
  -- hcond: la(k+1)^2 ≤ (1 + la k / la(k-1)) * la(k-1)^2
  -- target: la(k+1) * (la(k+1) / la k) ≤ (1 + la k / la(k-1)) * la k
  have hlk : alg.la k > 0 := alg.la_pos k
  have hlkm1 : alg.la (k - 1) > 0 := alg.la_pos (k - 1)
  have heq : alg.la (k + 1) * (alg.la (k + 1) / alg.la k) = alg.la (k + 1) ^ 2 / alg.la k := by
    field_simp
  have hkksq : alg.la k * alg.la k = alg.la k ^ 2 := by rw [pow_two]
  rw [heq, div_le_iff₀ hlk, mul_assoc, hkksq]
  exact hcond

set_option linter.unusedSectionVars false in
/-- Convexity inequality: f(y) ≥ f(z) + ⟨∇f(z), y - z⟩. -/
lemma convex_ineq (alg : AdGD f f') (z : E) (y : E) :
    f z + ⟪f' z, y - z⟫_ℝ ≤ f y := by
  have h := Convex_first_order_condition' (alg.diff z) alg.convex (mem_univ z) y
  simpa using h (mem_univ y)

set_option linter.unusedSectionVars false in
/-- x_{k+1} - x_k = -la_k • f'(x_k). -/
lemma update_diff (k : ℕ) : alg.x (k + 1) - alg.x k = - alg.la k • f' (alg.x k) := by
  rw [alg.update]
  module

set_option linter.unusedSectionVars false in
/-- x_k - x_{k+1} = la_k • f'(x_k). -/
lemma update_diff' (k : ℕ) : alg.x k - alg.x (k + 1) = alg.la k • f' (alg.x k) := by
  rw [alg.update, sub_sub_cancel]

set_option linter.unusedSectionVars false in
/-- For k ≥ 1, x_{k-1} - x_k = la_{k-1} • f'(x_{k-1}). -/
lemma prev_update_diff (k : ℕ) (hk : k ≥ 1) :
    alg.x (k - 1) - alg.x k = alg.la (k - 1) • f' (alg.x (k - 1)) := by
  rw [show alg.x k = alg.x (k - 1 + 1) by rw [Nat.sub_add_cancel hk]]
  rw [alg.update, sub_sub_cancel]

/-! ## Lemma 1: Energy Inequality -/

/-- Lemma 1: The two-step energy inequality for AdGD.

For any minimizer x* and k ≥ 1:
  ‖x_{k+1} - x*‖² + (1/2)‖x_{k+1} - x_k‖² + 2 la_k (1 + θ_k) (f(x_k) - f*)
    ≤ ‖x_k - x*‖² + (1/2)‖x_k - x_{k-1}‖² + 2 la_k θ_k (f(x_{k-1}) - f*)
-/
theorem energy_inequality (xstar : E) (hmin : IsMinOn f Set.univ xstar) (k : ℕ) (hk : k ≥ 1) :
    ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
      + 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
    ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
      + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar) := by
  -- Hypotheses
  have hla : alg.la k > 0 := alg.la_pos k
  have hlam1 : alg.la (k - 1) > 0 := alg.la_pos (k - 1)
  have hth : theta alg.la k = alg.la k / alg.la (k - 1) := algTheta_def k hk
  have hd2 : alg.x (k + 1) - alg.x k = - alg.la k • f' (alg.x k) := update_diff k
  have hneg_d2 : alg.x k - alg.x (k + 1) = alg.la k • f' (alg.x k) := update_diff' k
  have hprev : alg.x (k - 1) - alg.x k = alg.la (k - 1) • f' (alg.x (k - 1)) :=
    prev_update_diff k hk
  -- Convexity bounds (direct from convex_ineq, no rewriting needed)
  have hconv_star : ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ ≤ f xstar - f (alg.x k) := by
    linarith [convex_ineq alg (alg.x k) xstar]
  have hconv_prev : ⟪f' (alg.x k), alg.x (k - 1) - alg.x k⟫_ℝ
      ≤ f (alg.x (k - 1)) - f (alg.x k) := by
    linarith [convex_ineq alg (alg.x k) (alg.x (k - 1))]
  -- Step 1: Expand ‖x_{k+1} - x*‖²
  have hexpand : ‖alg.x (k + 1) - xstar‖ ^ 2 =
      ‖alg.x k - xstar‖ ^ 2 + 2 * ⟪alg.x k - xstar, alg.x (k + 1) - alg.x k⟫_ℝ
      + ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    have hdecomp : alg.x (k + 1) - xstar = (alg.x k - xstar) + (alg.x (k + 1) - alg.x k) := by
      abel
    rw [hdecomp, norm_add_sq_real]
  -- Step 2: Rewrite inner product using update
  have hinner : 2 * ⟪alg.x k - xstar, alg.x (k + 1) - alg.x k⟫_ℝ
      = 2 * alg.la k * ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ := by
    rw [hd2, real_inner_smul_right]
    have hswap : ⟪alg.x k - xstar, f' (alg.x k)⟫_ℝ = -⟪f' (alg.x k), xstar - alg.x k⟫_ℝ := by
      rw [inner_sub_left, inner_sub_right]
      have hcomm1 : ⟪alg.x k, f' (alg.x k)⟫_ℝ = ⟪f' (alg.x k), alg.x k⟫_ℝ :=
        real_inner_comm _ _
      have hcomm2 : ⟪xstar, f' (alg.x k)⟫_ℝ = ⟪f' (alg.x k), xstar⟫_ℝ :=
        real_inner_comm _ _
      rw [hcomm1, hcomm2]; ring
    rw [hswap]; ring
  -- Step 3: ‖x_{k+1}-x*‖² ≤ ‖x_k-x*‖² - 2*la*(f(x_k)-f*) + ‖d2‖²
  have hstep4 : ‖alg.x (k + 1) - xstar‖ ^ 2 ≤
      ‖alg.x k - xstar‖ ^ 2 - 2 * alg.la k * (f (alg.x k) - f xstar)
      + ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    rw [hexpand, hinner]
    have hmul : 2 * alg.la k * ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ
        ≤ 2 * alg.la k * (f xstar - f (alg.x k)) :=
      mul_le_mul_of_nonneg_left hconv_star (by positivity)
    linarith
  -- Step 5: Identity for ‖d2‖²
  have hd2_sq : ‖alg.x (k + 1) - alg.x k‖ ^ 2 = alg.la k ^ 2 * ‖f' (alg.x k)‖ ^ 2 := by
    rw [hd2]
    simp only [norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hla, mul_pow]
  have hident : ‖alg.x (k + 1) - alg.x k‖ ^ 2
      = 2 * alg.la k * ⟪f' (alg.x k), alg.x k - alg.x (k + 1)⟫_ℝ
        - ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    rw [hneg_d2, real_inner_smul_right, real_inner_self_eq_norm_sq, hd2_sq]
    ring
  -- Split the gradient term
  have hsplit : 2 * alg.la k * ⟪f' (alg.x k), alg.x k - alg.x (k + 1)⟫_ℝ
      = 2 * alg.la k * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        + 2 * alg.la k * ⟪f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ := by
    rw [inner_sub_left]; ring
  -- Bound 1: CS + stepsize + Young
  have hbound1 : 2 * alg.la k
      * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
      ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    have hcs : ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        ≤ ‖f' (alg.x k) - f' (alg.x (k - 1))‖ * ‖alg.x k - alg.x (k + 1)‖ :=
      real_inner_le_norm _ _
    have hstep := alg.stepsize_curvature k hk
    have h1 : 2 * alg.la k
        * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        ≤ ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖ := by
      calc 2 * alg.la k
          * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
          ≤ 2 * alg.la k * (‖f' (alg.x k) - f' (alg.x (k - 1))‖ * ‖alg.x k - alg.x (k + 1)‖) :=
            mul_le_mul_of_nonneg_left hcs (by positivity)
        _ = (2 * alg.la k * ‖f' (alg.x k) - f' (alg.x (k - 1))‖) * ‖alg.x k - alg.x (k + 1)‖ :=
            by ring
        _ ≤ ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖ :=
            mul_le_mul_of_nonneg_right hstep (norm_nonneg _)
    have hnorm_comm : ‖alg.x k - alg.x (k + 1)‖ = ‖alg.x (k + 1) - alg.x k‖ := by
      have : alg.x k - alg.x (k + 1) = -(alg.x (k + 1) - alg.x k) := by abel
      rw [this, norm_neg]
    have hyoung : ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖
        ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
          + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
      rw [hnorm_comm]
      have hsq : 0 ≤ (‖alg.x k - alg.x (k - 1)‖ - ‖alg.x (k + 1) - alg.x k‖) ^ 2 :=
        sq_nonneg _
      nlinarith [hsq]
    linarith
  -- Bound 2: convexity
  have hbound2 : 2 * alg.la k * ⟪f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
      ≤ 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) := by
    rw [hneg_d2, real_inner_smul_right]
    have hkey : alg.la k * ⟪f' (alg.x (k - 1)), f' (alg.x k)⟫_ℝ
        = theta alg.la k * ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ := by
      rw [hth, hprev, real_inner_smul_left]
      field_simp
    rw [hkey]
    have hth_pos : 0 < theta alg.la k := by rw [hth]; positivity
    have hconv_prev' : ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ
        ≤ f (alg.x (k - 1)) - f (alg.x k) := by
      rw [real_inner_comm]; exact hconv_prev
    have h1 : theta alg.la k * ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ
        ≤ theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) :=
      mul_le_mul_of_nonneg_left hconv_prev' (le_of_lt hth_pos)
    have h2la_pos : 0 ≤ 2 * alg.la k := by positivity
    rw [show 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
        = 2 * alg.la k * (theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))) by ring]
    exact mul_le_mul_of_nonneg_left h1 h2la_pos
  -- Combine bad term bound
  have hbad : ‖alg.x (k + 1) - alg.x k‖ ^ 2
      ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        - (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) := by
    rw [hident, hsplit]
    linarith [hbound1, hbound2]
  -- Final: combine hstep4 and hbad
  have hgoal : ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
      + 2 * alg.la k * (f (alg.x k) - f xstar)
      + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar)
    ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
      + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
      + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar) := by
    linarith [hstep4, hbad]
  -- Convert hgoal to the actual goal
  calc ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
      = ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * (f (alg.x k) - f xstar)
        + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar) := by ring
    _ ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
        + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar) := hgoal
    _ = ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar) := by ring

/-! ## Theorem 1: Boundedness and Rate -/

set_option linter.unusedSectionVars false in
/-- Weight w_k = λ_k(1+θ_k) - λ_{k+1}θ_{k+1} ≥ 0 for k ≥ 1. -/
def weight (alg : AdGD f f') (k : ℕ) : ℝ :=
  alg.la k * (1 + theta alg.la k) - alg.la (k + 1) * theta alg.la (k + 1)

set_option linter.unusedSectionVars false in
/-- w_k ≥ 0 by theta_growth_bound. -/
lemma weight_nonneg (alg : AdGD f f') (k : ℕ) (hk : k ≥ 1) : weight alg k ≥ 0 := by
  unfold weight
  have hg := @theta_growth_bound _ _ _ _ _ _ _ alg k hk
  linarith [hg, alg.la_pos k]

set_option linter.unusedSectionVars false in
/-- The energy E_k = ‖x_k - x*‖² + (1/2)‖x_k - x_{k-1}‖² + 2λ_k θ_k (f(x_{k-1}) - f*). -/
def energy (alg : AdGD f f') (xstar : E) (k : ℕ) : ℝ :=
  ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
    + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar)

set_option linter.unusedSectionVars false in
/-- The energy is non-increasing: E_{k+1} ≤ E_k for k ≥ 1. -/
theorem energy_nonincreasing (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (k : ℕ) (hk : k ≥ 1) : energy alg xstar (k + 1) ≤ energy alg xstar k := by
  have hei := @energy_inequality _ _ _ _ _ _ _ alg xstar hmin k hk
  have hfx : 0 ≤ f (alg.x k) - f xstar := by
    have h := hmin (mem_univ (alg.x k))
    simpa using h
  have hw : weight alg k ≥ 0 := weight_nonneg alg k hk
  have hwk : 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
      = 2 * alg.la (k + 1) * theta alg.la (k + 1) * (f (alg.x k) - f xstar)
        + 2 * weight alg k * (f (alg.x k) - f xstar) := by
    rw [weight]; ring
  rw [hwk] at hei
  have hnonneg : 2 * weight alg k * (f (alg.x k) - f xstar) ≥ 0 :=
    mul_nonneg (mul_nonneg (by norm_num) hw) hfx
  unfold energy
  have hksub : k + 1 - 1 = k := by omega
  rw [hksub]
  linarith

set_option linter.unusedSectionVars false in
/-- Boundedness: ‖x_{n+1} - x*‖² ≤ E_1 for all n ≥ 0. -/
theorem bounded (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar) (n : ℕ) :
    ‖alg.x (n + 1) - xstar‖ ^ 2 ≤ energy alg xstar 1 := by
  have hEn1 : energy alg xstar (n + 1) ≤ energy alg xstar 1 := by
    induction n with
    | zero => exact le_refl _
    | succ n ih =>
      have hstep := energy_nonincreasing alg xstar hmin (n + 1) (by omega)
      linarith
  -- Show ‖x_{n+1} - x*‖² ≤ energy alg xstar (n+1) since other terms in E are nonneg
  have hfx_n : f xstar ≤ f (alg.x n) := hmin (mem_univ (alg.x n))
  have hth_pos : 0 < theta alg.la (n + 1) := by
    rw [@algTheta_def _ _ _ _ _ _ _ alg (n + 1) (by omega)]
    exact div_pos (alg.la_pos (n + 1)) (alg.la_pos n)
  have hla_pos : 0 < alg.la (n + 1) := alg.la_pos (n + 1)
  have hle : ‖alg.x (n + 1) - xstar‖ ^ 2 ≤ energy alg xstar (n + 1) := by
    unfold energy
    have hn : n + 1 - 1 = n := by omega
    rw [hn]
    have h1 : (1/2 : ℝ) * ‖alg.x (n + 1) - alg.x n‖ ^ 2 ≥ 0 := by positivity
    have h2 : 2 * alg.la (n + 1) * theta alg.la (n + 1) * (f (alg.x n) - f xstar) ≥ 0 := by
      have hfx : 0 ≤ f (alg.x n) - f xstar := by linarith
      exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hla_pos.le) hth_pos.le) hfx
    linarith
  linarith [hle, hEn1]

/-! ## Concrete Algorithm 1: The min stepsize rule -/

/-- The concrete min stepsize rule from Algorithm 1.

For k = 1: when ‖∇f(x¹) - ∇f(x⁰)‖ > 0, λ₁ = ‖x¹ - x⁰‖ / (2‖∇f(x¹) - ∇f(x⁰)‖)
(the growth bound is +∞ since θ₀ = +∞). When the gradient difference is zero,
λ₁ can be any positive value.

For k ≥ 2: λ_k = min{√(1 + θ_{k-1}) · λ_{k-1}, ‖x^k - x^{k-1}‖ / (2‖∇f(x^k) - ∇f(x^{k-1})‖)}.
When the gradient difference is zero, the curvature bound is +∞, so λ_k = √(1 + θ_{k-1}) · λ_{k-1}.
-/
structure MinStepsizeRule (alg : AdGD f f') where
  init_rule : ‖f' (alg.x 1) - f' (alg.x 0)‖ = 0 ∨
    alg.la 1 = ‖alg.x 1 - alg.x 0‖ / (2 * ‖f' (alg.x 1) - f' (alg.x 0)‖)
  min_rule : ∀ k ≥ 2,
    if ‖f' (alg.x k) - f' (alg.x (k - 1))‖ = 0 then
      alg.la k = Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1)
    else
      alg.la k = min (Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1))
                     (‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖))

set_option linter.unusedSectionVars false in
/-- The min stepsize rule implies the growth condition: λ_k² ≤ (1 + θ_{k-1}) λ_{k-1}². -/
theorem min_rule_implies_growth (alg : AdGD f f') (hr : MinStepsizeRule alg) :
    ∀ k ≥ 2, alg.la k ^ 2 ≤ (1 + theta alg.la (k - 1)) * alg.la (k - 1) ^ 2 := by
  intro k hk
  have hrk := hr.min_rule k hk
  have hla_k : 0 < alg.la k := alg.la_pos k
  have hla_km1 : 0 < alg.la (k - 1) := alg.la_pos (k - 1)
  have htheta_pos : 0 < theta alg.la (k - 1) := by
    rw [algTheta_def (k - 1) (by omega)]
    exact div_pos hla_km1 (alg.la_pos (k - 2))
  have h1theta : 0 ≤ 1 + theta alg.la (k - 1) := by linarith
  by_cases hgrad : ‖f' (alg.x k) - f' (alg.x (k - 1))‖ = 0
  · rw [if_pos hgrad] at hrk
    rw [hrk, mul_pow, Real.sq_sqrt h1theta]
  · rw [if_neg hgrad] at hrk
    have hA_pos : 0 < Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1) := by
      have hsqrt : 0 < Real.sqrt (1 + theta alg.la (k - 1)) := Real.sqrt_pos.mpr (by linarith)
      exact mul_pos hsqrt hla_km1
    have hle : alg.la k ≤ Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1) :=
      hrk.le.trans (min_le_left _ _)
    have hsq : alg.la k ^ 2 ≤ (Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1)) ^ 2 :=
      (sq_le_sq₀ (le_of_lt hla_k) (le_of_lt hA_pos)).mpr hle
    rw [mul_pow, Real.sq_sqrt h1theta] at hsq
    exact hsq

set_option linter.unusedSectionVars false in
/-- The min stepsize rule implies the curvature condition:
    2 λ_k ‖∇f(x_k) - ∇f(x_{k-1})‖ ≤ ‖x_k - x_{k-1}‖. -/
theorem min_rule_implies_curvature (alg : AdGD f f') (hr : MinStepsizeRule alg) :
    ∀ k ≥ 1, 2 * alg.la k * ‖f' (alg.x k) - f' (alg.x (k - 1))‖ ≤ ‖alg.x k - alg.x (k - 1)‖ := by
  intro k hk
  by_cases hk1 : k = 1
  · -- k = 1: use init_rule
    have hsub : (1 - 1 : ℕ) = 0 := rfl
    by_cases hgrad : ‖f' (alg.x 1) - f' (alg.x 0)‖ = 0
    · rw [hk1, hsub, hgrad, mul_zero]
      exact norm_nonneg _
    · have hinit := hr.init_rule
      cases hinit with
      | inl h => exact absurd h hgrad
      | inr h =>
        rw [hk1, hsub, h]
        field_simp
        linarith
  · -- k ≥ 2
    have hk2 : k ≥ 2 := by omega
    by_cases hgrad : ‖f' (alg.x k) - f' (alg.x (k - 1))‖ = 0
    · rw [hgrad, mul_zero]
      exact norm_nonneg _
    · have hgrad_pos : 0 < ‖f' (alg.x k) - f' (alg.x (k - 1))‖ :=
        lt_of_le_of_ne (norm_nonneg _) (Ne.symm hgrad)
      have hrk := hr.min_rule k hk2
      rw [if_neg hgrad] at hrk
      have hle : alg.la k ≤ ‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖) :=
        hrk.le.trans (min_le_right _ _)
      have h2le : 2 * alg.la k ≤
          2 * (‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖)) := by linarith
      have hstep : 2 * alg.la k * ‖f' (alg.x k) - f' (alg.x (k - 1))‖ ≤
          2 * (‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖)) *
          ‖f' (alg.x k) - f' (alg.x (k - 1))‖ :=
        mul_le_mul_of_nonneg_right h2le hgrad_pos.le
      rw [show 2 * (‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖)) *
          ‖f' (alg.x k) - f' (alg.x (k - 1))‖ = ‖alg.x k - alg.x (k - 1)‖ by
        field_simp] at hstep
      exact hstep

set_option linter.unusedSectionVars false in
/-- All iterates are bounded: ∃ R ≥ 0, ∀ n, ‖x_n - x*‖ ≤ R.
This extends `bounded` to include n = 0. -/
theorem all_iterates_bounded (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar) :
    ∃ R ≥ 0, ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R := by
  have hE1_nonneg : 0 ≤ energy alg xstar 1 := by
    unfold energy
    have hfx0 : 0 ≤ f (alg.x 0) - f xstar := by
      have h := hmin (mem_univ (alg.x 0)); simpa using h
    have hth_pos : 0 < theta alg.la 1 := by
      rw [algTheta_def 1 (by omega)]
      exact div_pos (alg.la_pos 1) (alg.la_pos 0)
    have h1 : 0 ≤ ‖alg.x 1 - xstar‖ ^ 2 := sq_nonneg _
    have h2 : 0 ≤ (1/2 : ℝ) * ‖alg.x 1 - alg.x 0‖ ^ 2 := by positivity
    have h3 : 0 ≤ 2 * alg.la 1 * theta alg.la 1 * (f (alg.x 0) - f xstar) := by
      have hla : 0 < alg.la 1 := alg.la_pos 1
      exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hla.le) hth_pos.le) hfx0
    linarith
  use Real.sqrt (4 * energy alg xstar 1) + Real.sqrt (energy alg xstar 1)
  refine ⟨?_, ?_⟩
  · have hE : 0 ≤ energy alg xstar 1 := hE1_nonneg
    have h1 : 0 ≤ Real.sqrt (4 * energy alg xstar 1) := Real.sqrt_nonneg _
    have h2 : 0 ≤ Real.sqrt (energy alg xstar 1) := Real.sqrt_nonneg _
    linarith
  · intro n
    by_cases hn : n = 0
    · rw [hn]
      have hb1 : ‖alg.x 1 - xstar‖ ^ 2 ≤ energy alg xstar 1 := bounded alg xstar hmin 0
      have h01 : ‖alg.x 1 - xstar‖ ≤ Real.sqrt (energy alg xstar 1) :=
        (Real.le_sqrt (norm_nonneg _) hE1_nonneg).mpr hb1
      have htri : ‖alg.x 0 - xstar‖ ≤ ‖alg.x 0 - alg.x 1‖ + ‖alg.x 1 - xstar‖ := by
        rw [show alg.x 0 - xstar = (alg.x 0 - alg.x 1) + (alg.x 1 - xstar) by abel]
        exact norm_add_le _ _
      have hnorm01 : ‖alg.x 0 - alg.x 1‖ = ‖alg.x 1 - alg.x 0‖ := by
        have : alg.x 0 - alg.x 1 = -(alg.x 1 - alg.x 0) := by abel
        rw [this, norm_neg]
      rw [hnorm01] at htri
      have hnorm_bound : ‖alg.x 1 - alg.x 0‖ ≤ Real.sqrt (2 * energy alg xstar 1) := by
        have hle : (1/2 : ℝ) * ‖alg.x 1 - alg.x 0‖ ^ 2 ≤ energy alg xstar 1 := by
          unfold energy
          have hfx0 : 0 ≤ f (alg.x 0) - f xstar := by
            have h := hmin (mem_univ (alg.x 0)); simpa using h
          have hth_pos : 0 < theta alg.la 1 := by
            rw [algTheta_def 1 (by omega)]
            exact div_pos (alg.la_pos 1) (alg.la_pos 0)
          have h1 : 0 ≤ ‖alg.x 1 - xstar‖ ^ 2 := sq_nonneg _
          have h3 : 0 ≤ 2 * alg.la 1 * theta alg.la 1 * (f (alg.x 0) - f xstar) := by
            have hla : 0 < alg.la 1 := alg.la_pos 1
            exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hla.le) hth_pos.le) hfx0
          linarith
        have h2 : ‖alg.x 1 - alg.x 0‖ ^ 2 ≤ 2 * energy alg xstar 1 := by linarith
        exact (Real.le_sqrt (norm_nonneg _) (by linarith)).mpr h2
      calc ‖alg.x 0 - xstar‖ ≤ ‖alg.x 1 - alg.x 0‖ + ‖alg.x 1 - xstar‖ := htri
        _ ≤ Real.sqrt (2 * energy alg xstar 1) + Real.sqrt (energy alg xstar 1) :=
          by linarith [hnorm_bound, h01]
        _ ≤ Real.sqrt (4 * energy alg xstar 1) + Real.sqrt (energy alg xstar 1) := by
          apply add_le_add_right
          apply Real.sqrt_le_sqrt
          linarith
    · have hb := bounded alg xstar hmin (n - 1)
      have hx : alg.x n = alg.x ((n - 1) + 1) := by rw [Nat.sub_add_cancel (by omega)]
      rw [hx]
      have hle_sqrt : ‖alg.x ((n - 1) + 1) - xstar‖ ≤ Real.sqrt (energy alg xstar 1) :=
        (Real.le_sqrt (norm_nonneg _) hE1_nonneg).mpr hb
      have hextra : 0 ≤ Real.sqrt (4 * energy alg xstar 1) := Real.sqrt_nonneg _
      linarith [hle_sqrt, hextra]

/-! ## Uniform Positive Lower Bound on Stepsize -/

set_option linter.unusedSectionVars false in
/-- Under the concrete min rule and global L-Lipschitz continuity of ∇f,
    the stepsize has a uniform positive lower bound λ_k ≥ c for all k ≥ 1,
    where c = min{λ₁, 1/(2L)}.

    The proof uses strong induction:
    - Base (k=1): λ₁ ≥ min{λ₁, 1/(2L)} trivially.
    - Step (k≥2): λ_k = min{√(1+θ_{k-1})λ_{k-1}, curvature_bound}.
      Growth bound ≥ λ_{k-1} ≥ c (by IH, since √(1+θ) ≥ 1).
      Curvature bound ≥ 1/(2L) ≥ c (by Lipschitz).
      So the min is also ≥ c.

    When the gradient difference ‖∇f(x¹)-∇f(x⁰)‖ > 0, init_rule gives
    λ₁ = ‖x¹-x⁰‖/(2‖∇f(x¹)-∇f(x⁰)‖) ≥ 1/(2L) by Lipschitz, so c = 1/(2L).
    When the gradient difference is zero, c = min{λ₁, 1/(2L)} > 0 still holds
    since λ₁ > 0 by `la_pos`.
-/
theorem stepsize_lower_bound (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (L : ℝ) (hL : L > 0)
    (hlip : ∀ n m : ℕ, ‖f' (alg.x n) - f' (alg.x m)‖ ≤ L * ‖alg.x n - alg.x m‖) :
    ∀ k ≥ 1, alg.la k ≥ min (alg.la 1) (1 / (2 * L)) := by
  set c := min (alg.la 1) (1 / (2 * L))
  have hc_pos : 0 < c := lt_min (alg.la_pos 1) (by positivity)
  intro k hk
  induction k using Nat.strong_induction_on with
  | h k ih =>
    by_cases hk0 : k = 0
    · exfalso; omega
    by_cases hk1 : k = 1
    · rw [hk1]; exact min_le_left _ _
    have hk2 : k ≥ 2 := by omega
    have hrk := hr.min_rule k hk2
    have htheta_pos : 0 < theta alg.la (k - 1) := by
      rw [algTheta_def (k - 1) (by omega)]
      exact div_pos (alg.la_pos (k - 1)) (alg.la_pos (k - 2))
    have hsqrt_ge_1 : 1 ≤ Real.sqrt (1 + theta alg.la (k - 1)) :=
      Real.one_le_sqrt.mpr (by linarith)
    have hlb_km1 : alg.la (k - 1) ≥ c := ih (k - 1) (by omega) (by omega)
    have hgrowth_lb : Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1) ≥ c := by
      have hprod : 1 * alg.la (k - 1) ≤ Real.sqrt (1 + theta alg.la (k - 1)) * alg.la (k - 1) :=
        mul_le_mul_of_nonneg_right hsqrt_ge_1 (alg.la_pos (k - 1)).le
      linarith [hprod, hlb_km1]
    have hcurv_ge_c : 1 / (2 * L) ≥ c := min_le_right _ _
    by_cases hgrad : ‖f' (alg.x k) - f' (alg.x (k - 1))‖ = 0
    · rw [if_pos hgrad] at hrk
      rw [hrk]
      exact hgrowth_lb
    · rw [if_neg hgrad] at hrk
      rw [hrk]
      have hgrad_pos : 0 < ‖f' (alg.x k) - f' (alg.x (k - 1))‖ :=
        lt_of_le_of_ne (norm_nonneg _) (Ne.symm hgrad)
      have hlip_kk := hlip k (k - 1)
      have hxdiff_pos : 0 < ‖alg.x k - alg.x (k - 1)‖ := by
        by_contra h'
        push_neg at h'
        have h'eq : ‖alg.x k - alg.x (k - 1)‖ = 0 := le_antisymm h' (norm_nonneg _)
        rw [h'eq] at hlip_kk
        linarith
      have hcurv_lb :
          ‖alg.x k - alg.x (k - 1)‖ / (2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖) ≥
          1 / (2 * L) := by
        exact (div_le_div_iff₀ (by linarith : (0 : ℝ) < 2 * L)
          (by linarith : (0 : ℝ) < 2 * ‖f' (alg.x k) - f' (alg.x (k - 1))‖)).mpr
          (by linarith [hlip_kk])
      exact le_min hgrowth_lb (hcurv_ge_c.trans hcurv_lb)

/-! ## Rate: Weighted Average and O(1/k) -/

set_option linter.unusedSectionVars false in
/-- Key step: E_{k+1} + 2 * w_k * (f(x_k) - f*) ≤ E_k for k ≥ 1.
    This is the energy inequality with the weight term kept explicit. -/
lemma energy_step (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (k : ℕ) (hk : k ≥ 1) :
    energy alg xstar (k + 1) + 2 * weight alg k * (f (alg.x k) - f xstar) ≤
    energy alg xstar k := by
  have hei := @energy_inequality _ _ _ _ _ _ _ alg xstar hmin k hk
  have hwk : 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
      = 2 * alg.la (k + 1) * theta alg.la (k + 1) * (f (alg.x k) - f xstar)
        + 2 * weight alg k * (f (alg.x k) - f xstar) := by
    rw [weight]; ring
  rw [hwk] at hei
  unfold energy
  have hksub : k + 1 - 1 = k := by omega
  rw [hksub]
  linarith [hei]

/-- The constant D from Theorem 1: D = ‖x¹ - x*‖² + (1/2)‖x¹ - x⁰‖² + 2λ₁θ₁(f(x⁰) - f*).
    This equals `energy alg xstar 1`. -/
def rate_constant (alg : AdGD f f') (xstar : E) : ℝ :=
  ‖alg.x 1 - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x 1 - alg.x 0‖ ^ 2
    + 2 * alg.la 1 * theta alg.la 1 * (f (alg.x 0) - f xstar)

/-- S_k = Σ_{i=1}^k λ_i + λ₁θ₁ (the total weight). -/
def total_weight (alg : AdGD f f') (k : ℕ) : ℝ :=
  (∑ i ∈ Finset.range (k + 1), (if i = 0 then (0 : ℝ) else alg.la i)) + alg.la 1 * theta alg.la 1

set_option linter.unusedSectionVars false in
/-- Telescoping the energy inequality gives:
    E_{k+1} + 2 Σ_{i=1}^{k} w_i (f(x_i) - f*) ≤ D. -/
theorem energy_telescoping (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (k : ℕ) (hk : k ≥ 1) :
    energy alg xstar (k + 1)
      + 2 * ∑ i ∈ Finset.range (k + 1), (if i = 0 then (0 : ℝ) else weight alg i * (f (alg.x i) - f xstar))
    ≤ rate_constant alg xstar := by
  induction k with
  | zero =>
    simp [Finset.range, energy, rate_constant]
  | succ k ih =>
    have hk1 : k + 1 ≥ 1 := by omega
    have hstep := energy_step alg xstar hmin (k + 1) hk1
    rw [Finset.sum_range_succ]
    by_cases hk0 : k + 1 = 0
    · omega
    · simp [hk0]
      by_cases hk_ge1 : k ≥ 1
      · have ih' := ih hk_ge1
        linarith [hstep, ih']
      · have hk0_eq : k = 0 := by omega
        rw [hk0_eq] at hstep
        rw [hk0_eq]
        simp [Finset.range] at hstep ⊢
        rw [mul_assoc 2 (weight alg 1) (f (alg.x 1) - f xstar)] at hstep
        have hE1 : energy alg xstar 1 ≤ rate_constant alg xstar := by
          simp [energy, rate_constant]
        linarith [hstep, hE1]

set_option linter.unusedSectionVars false in
/-- S_k > 0 for k ≥ 1, since each λ_i > 0 and λ₁θ₁ ≥ 0. -/
theorem total_weight_pos (alg : AdGD f f') (k : ℕ) (hk : k ≥ 1) :
    0 < total_weight alg k := by
  unfold total_weight
  have hnonneg : ∀ i ∈ Finset.range (k + 1), 0 ≤ (if i = 0 then (0 : ℝ) else alg.la i) := by
    intro i _
    by_cases hi : i = 0
    · simp [hi]
    · simp [hi]
      exact le_of_lt (alg.la_pos i)
  have h1_in : (1 : ℕ) ∈ Finset.range (k + 1) := by simp [Finset.range]; omega
  have h1_val : (if (1 : ℕ) = 0 then (0 : ℝ) else alg.la 1) = alg.la 1 := by simp
  have hsum : alg.la 1 ≤ ∑ i ∈ Finset.range (k + 1), (if i = 0 then (0 : ℝ) else alg.la i) := by
    rw [← h1_val]
    exact Finset.single_le_sum hnonneg h1_in
  have htheta : 0 ≤ alg.la 1 * theta alg.la 1 := by
    have hth : 0 < theta alg.la 1 := by
      rw [algTheta_def 1 (by omega)]
      exact div_pos (alg.la_pos 1) (alg.la_pos 0)
    exact mul_nonneg (alg.la_pos 1).le hth.le
  linarith [alg.la_pos 1, hsum, htheta]

/-- Helper: ∑_{i=0}^k (if i=0 then 0 else c) = k * c -/
private lemma sum_if_zero_eq (k : ℕ) (c : ℝ) :
    ∑ i ∈ Finset.range (k + 1), (if i = 0 then (0 : ℝ) else c) = ↑k * c := by
  induction k with
  | zero => simp [Finset.range]
  | succ k ih =>
    rw [Finset.sum_range_succ]
    by_cases hk0 : k + 1 = 0
    · omega
    · simp [hk0]
      rw [ih]
      ring

set_option linter.unusedSectionVars false in
/-- S_k ≥ k * c where c = min{λ₁, 1/(2L)}, since each λ_i ≥ c and λ₁θ₁ ≥ 0. -/
theorem total_weight_lower_bound (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (L : ℝ) (hL : L > 0)
    (hlip : ∀ n m : ℕ, ‖f' (alg.x n) - f' (alg.x m)‖ ≤ L * ‖alg.x n - alg.x m‖)
    (k : ℕ) (hk : k ≥ 1) :
    total_weight alg k ≥ k * min (alg.la 1) (1 / (2 * L)) := by
  set c := min (alg.la 1) (1 / (2 * L))
  have hlb := stepsize_lower_bound alg hr L hL hlip
  have htheta_nn : 0 ≤ alg.la 1 * theta alg.la 1 := by
    have hth : 0 < theta alg.la 1 := by
      rw [algTheta_def 1 (by omega)]
      exact div_pos (alg.la_pos 1) (alg.la_pos 0)
    exact mul_nonneg (alg.la_pos 1).le hth.le
  have hc_pos : 0 < c := lt_min (alg.la_pos 1) (by positivity)
  have hlb_all : ∀ i ∈ Finset.range (k + 1),
      (if i = 0 then (0 : ℝ) else c) ≤ (if i = 0 then (0 : ℝ) else alg.la i) := by
    intro i hi
    by_cases hi0 : i = 0
    · simp [hi0]
    · simp [hi0]
      exact hlb i (by simp [Finset.range] at hi; omega)
  have hsum_lb : ↑k * c ≤ ∑ i ∈ Finset.range (k + 1), (if i = 0 then (0 : ℝ) else alg.la i) := by
    rw [← sum_if_zero_eq k c]
    exact Finset.sum_le_sum hlb_all
  unfold total_weight
  linarith [htheta_nn, hsum_lb]

/-! ## Direct summation: O(1/k) rate via Jensen -/

/-- The "effective weight" for iterate i in the telescoped sum:
    - For i < k: w_i = λ_i(1+θ_i) - λ_{i+1}θ_{i+1}
    - For i = k: λ_k(1+θ_k)
    - For i = 0: 0 -/
def effective_weight (alg : AdGD f f') (k : ℕ) (i : ℕ) : ℝ :=
  if i = 0 then 0
  else if i = k then alg.la k * (1 + theta alg.la k)
  else alg.la i * (1 + theta alg.la i) - alg.la (i + 1) * theta alg.la (i + 1)

set_option linter.unusedSectionVars false in
/-- The effective weights sum to total_weight S_k.
    Key: Σ_{i=1}^{k-1} w_i = Σ_{i=1}^{k-1} λ_i + λ_1θ_1 - λ_kθ_k (telescoping). -/
theorem effective_weight_sum (alg : AdGD f f') (k : ℕ) (hk : k ≥ 1) :
    ∑ i ∈ Finset.range (k + 1), effective_weight alg k i = total_weight alg k := by
  have h0k : (0 : ℕ) ≠ k := by omega
  -- Split off last element from LHS
  rw [Finset.sum_range_succ]
  -- For i < k: ew(k,i) = if i=0 then 0 else weight(i)
  have hew_lt : ∀ i ∈ Finset.range k,
      effective_weight alg k i = (if i = 0 then (0 : ℝ) else weight alg i) := by
    intro i hi
    have hik : i ≠ k := by simp [Finset.range] at hi; omega
    unfold effective_weight
    rw [if_neg hik]
    by_cases hi0 : i = 0
    · rw [if_pos hi0, if_pos hi0]
    · rw [if_neg hi0, if_neg hi0]
      unfold weight
      rfl
  -- ew_k = w_k + λ_{k+1}θ_{k+1}
  have hew_k : effective_weight alg k k = weight alg k +
      alg.la (k + 1) * theta alg.la (k + 1) := by
    unfold effective_weight weight
    simp only [if_neg (Ne.symm h0k), if_pos rfl, if_true, ↓reduceIte]
    ring
  rw [hew_k, Finset.sum_congr rfl hew_lt]
  -- Now LHS = Σ_{i<k} (if i=0 then 0 else w_i) + w_k + λ_{k+1}θ_{k+1}
  -- = Σ_{i=1}^{k-1} w_i + w_k + λ_{k+1}θ_{k+1}
  -- = Σ_{i=1}^k w_i + λ_{k+1}θ_{k+1}
  -- = [Σ_{i=1}^k λ_i + λ_1θ_1 - λ_{k+1}θ_{k+1}] + λ_{k+1}θ_{k+1}  (telescope)
  -- = Σ_{i=1}^k λ_i + λ_1θ_1 = total_weight
  -- Split total_weight similarly
  unfold total_weight
  rw [Finset.sum_range_succ]
  simp only [if_neg (Ne.symm h0k), ↓reduceIte]
  -- Now need to show:
  -- Σ_{i<k} (if i=0 then 0 else w_i) + w_k + λ_{k+1}θ_{k+1} =
  -- (Σ_{i<k} (if i=0 then 0 else λ_i)) + λ_k + λ_1θ_1
  -- Key: Σ_{i=1}^{k-1} w_i = Σ_{i=1}^{k-1} λ_i + λ_1θ_1 - λ_kθ_k (telescoping)
  -- So: Σ w_i + w_k + λ_{k+1}θ_{k+1} = [Σ λ_i + λ_1θ_1 - λ_kθ_k] + [λ_k + λ_kθ_k - λ_{k+1}θ_{k+1}] + λ_{k+1}θ_{k+1}
  --   = Σ λ_i + λ_1θ_1 + λ_k = (Σ_{i<k} λ_i) + λ_k + λ_1θ_1 ✓
  -- Prove the telescoping identity by induction
  have htele : ∀ j : ℕ, j ≥ 1 →
      ∑ i ∈ Finset.range j, (if i = 0 then (0 : ℝ) else weight alg i) =
      (∑ i ∈ Finset.range j, (if i = 0 then (0 : ℝ) else alg.la i)) +
      alg.la 1 * theta alg.la 1 - alg.la j * theta alg.la j := by
    intro j hj
    revert hj
    induction j with
    | zero => intro hj; simp at hj
    | succ j ih =>
      intro hj
      by_cases hj0 : j = 0
      · -- j=0, j+1=1: both sides are 0
        subst hj0
        simp [Finset.range, if_pos rfl]
      · have hj_ge1 : j ≥ 1 := by omega
        rw [Finset.sum_range_succ, Finset.sum_range_succ]
        simp only [if_neg hj0, ↓reduceIte]
        rw [ih hj_ge1]
        unfold weight
        ring
  rw [htele k hk]
  unfold weight
  ring

set_option linter.unusedSectionVars false in
/-- The effective weights are non-negative. -/
theorem effective_weight_nonneg (alg : AdGD f f') (k : ℕ) (hk : k ≥ 1) :
    ∀ i ∈ Finset.range (k + 1), 0 ≤ effective_weight alg k i := by
  intro i hi
  unfold effective_weight
  by_cases hi0 : i = 0
  · simp [hi0]
  · by_cases hik : i = k
    · simp only [hi0, if_neg hi0, if_pos hik, if_true, ↓reduceIte]
      have hth_nn : 0 ≤ theta alg.la k := by
        have hth_pos : 0 < theta alg.la k := by
          rw [algTheta_def k hk]
          exact div_pos (alg.la_pos k) (alg.la_pos (k - 1))
        exact le_of_lt hth_pos
      exact mul_nonneg (alg.la_pos k).le (by linarith [hth_nn])
    · simp only [hi0, if_neg hi0, if_neg hik, if_false, ↓reduceIte]
      exact weight_nonneg alg i (by simp [Finset.range] at hi; omega)

set_option linter.unusedSectionVars false in
set_option linter.unusedSectionVars false in
/-- From energy_telescoping, we get the paper's equation (11):
    2 * [λ_k(1+θ_k)(f(x_k)-f*) + Σ_{i=1}^{k-1} w_i(f(x_i)-f*)] ≤ D
    (after dropping the non-negative norm terms and combining E_{k+1} with w_k). -/
theorem telescoped_bound (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (k : ℕ) (hk : k ≥ 1) :
    2 * ∑ i ∈ Finset.range (k + 1),
        (effective_weight alg k i * (f (alg.x i) - f xstar))
    ≤ rate_constant alg xstar := by
  have htel := energy_telescoping alg xstar hmin k hk
  have hfx_nn : ∀ i : ℕ, 0 ≤ f (alg.x i) - f xstar := by
    intro i; have h := hmin (mem_univ (alg.x i)); simpa using h
  have hE : energy alg xstar (k + 1) =
      ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la (k + 1) * theta alg.la (k + 1) * (f (alg.x k) - f xstar) := by
    unfold energy; rw [show (k + 1 - 1 : ℕ) = k by omega]
  rw [hE] at htel
  have hkey : ∑ i ∈ Finset.range (k + 1),
      (effective_weight alg k i * (f (alg.x i) - f xstar)) =
    ∑ i ∈ Finset.range (k + 1),
      (if i = 0 then (0 : ℝ) else weight alg i * (f (alg.x i) - f xstar))
    + alg.la (k + 1) * theta alg.la (k + 1) * (f (alg.x k) - f xstar) := by
    have h0k : (0 : ℕ) ≠ k := by omega
    -- Split off last element from both sums
    rw [Finset.sum_range_succ, Finset.sum_range_succ]
    -- For i < k: effective_weight(k,i) * (f-f*) = (if i=0 then 0 else w_i * (f-f*))
    have hew_lt : ∀ i ∈ Finset.range k,
        effective_weight alg k i * (f (alg.x i) - f xstar) =
        (if i = 0 then (0 : ℝ) else weight alg i * (f (alg.x i) - f xstar)) := by
      intro i hi
      have hik : i ≠ k := by simp [Finset.range] at hi; omega
      unfold effective_weight
      rw [if_neg hik]
      by_cases hi0 : i = 0
      · rw [if_pos hi0, if_pos hi0, zero_mul]
      · rw [if_neg hi0, if_neg hi0]
        unfold weight
        rfl
    -- ew_k = w_k + λ_{k+1}θ_{k+1}
    have hew_k : effective_weight alg k k = weight alg k +
        alg.la (k + 1) * theta alg.la (k + 1) := by
      unfold effective_weight weight
      simp only [if_neg (Ne.symm h0k), if_pos rfl, if_true, ↓reduceIte]
      ring
    rw [hew_k, Finset.sum_congr rfl hew_lt]
    simp only [if_neg (Ne.symm h0k), ↓reduceIte]
    ring
  have hnorm_nn : 0 ≤ ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    have h1 : 0 ≤ ‖alg.x (k + 1) - xstar‖ ^ 2 := sq_nonneg _
    have h2 : 0 ≤ (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by positivity
    linarith
  linarith [htel, hnorm_nn, hkey]

/-- The weighted average x̂_k = (1/S_k) Σ_{i=1}^k α_i • x_i
    where α_i = effective_weight. -/
def weighted_average (alg : AdGD f f') (k : ℕ) : E :=
  (∑ i ∈ Finset.range (k + 1), effective_weight alg k i)⁻¹ •
    ∑ i ∈ Finset.range (k + 1), effective_weight alg k i • alg.x i

set_option linter.unusedSectionVars false in
/-- **Theorem 1 (Rate)**: f(x̂_k) - f* ≤ D / (2 * S_k) ≤ D / (2 * k * c). -/
theorem rate_theorem (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0)
    (hlip : ∀ n m : ℕ, ‖f' (alg.x n) - f' (alg.x m)‖ ≤ L * ‖alg.x n - alg.x m‖)
    (k : ℕ) (hk : k ≥ 1) :
    f (weighted_average alg k) - f xstar ≤
      rate_constant alg xstar / (2 * total_weight alg k) ∧
    rate_constant alg xstar / (2 * total_weight alg k) ≤
      rate_constant alg xstar / (2 * ↑k * min (alg.la 1) (1 / (2 * L))) := by
  -- S_k = Σ ew_i = total_weight
  have hS_eq : ∑ i ∈ Finset.range (k + 1), effective_weight alg k i = total_weight alg k :=
    effective_weight_sum alg k hk
  -- S_k > 0
  have hS_pos : 0 < total_weight alg k := total_weight_pos alg k hk
  -- S_k ≥ k * c
  have hS_lb : total_weight alg k ≥ ↑k * min (alg.la 1) (1 / (2 * L)) :=
    total_weight_lower_bound alg hr L hL hlip k hk
  -- 2 * Σ ew_i * (f_i - f*) ≤ D
  have htel := telescoped_bound alg xstar hmin k hk
  -- D ≥ 0
  have hD_nn : 0 ≤ rate_constant alg xstar := by
    unfold rate_constant
    have h1 : 0 ≤ ‖alg.x 1 - xstar‖ ^ 2 := sq_nonneg _
    have h2 : 0 ≤ (1/2 : ℝ) * ‖alg.x 1 - alg.x 0‖ ^ 2 := by positivity
    have h3 : 0 ≤ 2 * alg.la 1 * theta alg.la 1 * (f (alg.x 0) - f xstar) := by
      have hth_pos : 0 < theta alg.la 1 := by
        rw [algTheta_def 1 (by omega)]
        exact div_pos (alg.la_pos 1) (alg.la_pos 0)
      have hfx0 : 0 ≤ f (alg.x 0) - f xstar := by
        have h := hmin (mem_univ (alg.x 0)); simpa using h
      exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (alg.la_pos 1).le) hth_pos.le) hfx0
    linarith [h1, h2, h3]
  -- Set up normalized weights
  set S := total_weight alg k with hS_def
  set ew := fun (i : ℕ) => effective_weight alg k i
  set w := fun (i : ℕ) => ew i / S
  -- Weights non-negative
  have hew_nn : ∀ i ∈ Finset.range (k + 1), 0 ≤ ew i := effective_weight_nonneg alg k hk
  have hw_nn : ∀ i ∈ Finset.range (k + 1), 0 ≤ w i := by
    intro i hi
    exact div_nonneg (hew_nn i hi) (le_of_lt hS_pos)
  -- Weights sum to 1
  have hw_sum : ∑ i ∈ Finset.range (k + 1), w i = 1 := by
    rw [← Finset.sum_div, hS_eq, hS_def, div_self (ne_of_gt hS_pos)]
  -- Weighted average = Σ w_i • x_i
  have havg_eq : weighted_average alg k = ∑ i ∈ Finset.range (k + 1), w i • alg.x i := by
    unfold weighted_average w ew
    rw [hS_eq, hS_def, Finset.smul_sum]
    congr; ext i
    rw [smul_smul, mul_comm, div_eq_mul_inv]
  -- Jensen: f(Σ w_i • x_i) ≤ Σ w_i * f(x_i)
  have hjensen : f (∑ i ∈ Finset.range (k + 1), w i • alg.x i) ≤
      ∑ i ∈ Finset.range (k + 1), w i • f (alg.x i) := by
    exact alg.convex.map_sum_le hw_nn hw_sum (fun i _ => trivial)
  -- f(x_i) - f* ≥ 0
  have hfx_nn : ∀ i : ℕ, 0 ≤ f (alg.x i) - f xstar := by
    intro i; have h := hmin (mem_univ (alg.x i)); simpa using h
  -- Part 1: f(x̂_k) - f* ≤ D / (2 * S)
  have hpart1 : f (weighted_average alg k) - f xstar ≤ rate_constant alg xstar / (2 * S) := by
    rw [havg_eq]
    -- In ℝ, w_i • f(x_i) = (ew_i * f(x_i)) / S
    have hsmul_eq : ∀ i ∈ Finset.range (k + 1), w i • f (alg.x i) = (ew i * f (alg.x i)) / S := by
      intro i _; rw [smul_eq_mul, show w i = ew i / S from rfl, div_mul_eq_mul_div]
    rw [Finset.sum_congr rfl hsmul_eq, ← Finset.sum_div] at hjensen
    -- hjensen: f(x̂) ≤ (Σ ew_i * f(x_i)) / S
    -- Split: Σ ew_i * f(x_i) = Σ ew_i * (f_i - f*) + S * f*
    have hsum_split : ∑ i ∈ Finset.range (k + 1), (ew i * f (alg.x i)) =
        ∑ i ∈ Finset.range (k + 1), (ew i * (f (alg.x i) - f xstar)) + S * f xstar := by
      have : ∀ i ∈ Finset.range (k + 1),
          ew i * f (alg.x i) = ew i * (f (alg.x i) - f xstar) + ew i * f xstar := by
        intro i _; ring
      rw [Finset.sum_congr rfl this, Finset.sum_add_distrib, ← Finset.sum_mul, hS_eq, hS_def]
    -- Let A = Σ ew_i * (f_i - f*). Then hjensen says f(x̂) ≤ (A + S*f*) / S = A/S + f*
    set A := ∑ i ∈ Finset.range (k + 1), (ew i * (f (alg.x i) - f xstar))
    have hA_le : A ≤ rate_constant alg xstar / 2 := by
      have h2A : 2 * A ≤ rate_constant alg xstar := htel
      linarith [h2A, hD_nn]
    -- (A + S * f*) / S = A / S + f*
    have hdiv_split : (A + S * f xstar) / S = A / S + f xstar := by
      rw [add_div, mul_div_cancel_left₀ _ hS_pos.ne']
    rw [hsum_split, hdiv_split] at hjensen
    -- hjensen: f(x̂) ≤ A / S + f*, so f(x̂) - f* ≤ A / S ≤ D / (2 * S)
    have h1 : f (∑ i ∈ Finset.range (k + 1), w i • alg.x i) - f xstar ≤ A / S := by linarith [hjensen]
    have h2 : A / S ≤ rate_constant alg xstar / (2 * S) := by
      have h2A : 2 * A ≤ rate_constant alg xstar := htel
      rw [div_le_div_iff₀ hS_pos (by linarith [hS_pos])]
      nlinarith [h2A, hS_pos]
    linarith [h1, h2]
  -- Part 2: D / (2*S) ≤ D / (2*k*c)
  have hc_pos : 0 < min (alg.la 1) (1 / (2 * L)) := lt_min (alg.la_pos 1) (by positivity)
  have hkc_pos : 0 < ↑k * min (alg.la 1) (1 / (2 * L)) :=
    mul_pos (by exact_mod_cast (show (0:ℕ) < k from hk)) hc_pos
  have h2S_pos : 0 < 2 * S := by linarith [hS_pos]
  have h2kc_pos : 0 < 2 * ↑k * min (alg.la 1) (1 / (2 * L)) := by linarith [hkc_pos]
  have hpart2 : rate_constant alg xstar / (2 * S) ≤
      rate_constant alg xstar / (2 * ↑k * min (alg.la 1) (1 / (2 * L))) := by
    rw [div_le_div_iff₀ h2S_pos h2kc_pos]
    have h2kc_le_2S : 2 * ↑k * min (alg.la 1) (1 / (2 * L)) ≤ 2 * S := by linarith [hS_lb]
    exact mul_le_mul_of_nonneg_left h2kc_le_2S hD_nn
  exact ⟨hpart1, hpart2⟩

/-! ## Bridging Local Lipschitz to Uniform Lipschitz on Iterates

The original problem assumes ∇f is locally Lipschitz (for any bounded set C,
there exists L > 0 with ‖∇f(x)-∇f(y)‖ ≤ L‖x-y‖ for x,y ∈ C). Combined with
`all_iterates_bounded`, this gives a single uniform L > 0 valid on all iterate
pairs, which instantiates `rate_theorem` using only original-problem hypotheses.
-/

/-- The gradient f' is locally Lipschitz: for any closed ball of radius R ≥ 0
    centered at c, there exists L > 0 such that
    ‖f'(x) - f'(y)‖ ≤ L * ‖x - y‖ for all x, y in the ball.

    This is the original-problem assumption (local Lipschitz of ∇f),
    specialized to balls — equivalent to the standard formulation on bounded
    sets in normed spaces. -/
def GradientLocallyLipschitz (f' : E → E) : Prop :=
  ∀ (c : E) (R : ℝ), 0 ≤ R →
    ∃ L > 0, ∀ x y, ‖x - c‖ ≤ R → ‖y - c‖ ≤ R →
      ‖f' x - f' y‖ ≤ L * ‖x - y‖

set_option linter.unusedSectionVars false in
/-- From local Lipschitz of ∇f and boundedness of all iterates, we obtain a
    single uniform Lipschitz constant L > 0 valid on all pairs of iterates.
    This bridges the original-problem assumption to the hypothesis needed by
    `stepsize_lower_bound` and `rate_theorem`. -/
theorem uniform_lipschitz_from_iterates (hloc : GradientLocallyLipschitz f')
    (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar) :
    ∃ L > 0, ∀ n m : ℕ,
      ‖f' (alg.x n) - f' (alg.x m)‖ ≤ L * ‖alg.x n - alg.x m‖ := by
  obtain ⟨R, hR_nn, hR⟩ := all_iterates_bounded alg xstar hmin
  obtain ⟨L, hL_pos, hLip⟩ := hloc xstar R hR_nn
  refine ⟨L, hL_pos, ?_⟩
  intro n m
  exact hLip (alg.x n) (alg.x m) (hR n) (hR m)

set_option linter.unusedSectionVars false in
/-- **Theorem 1 (Rate, from original assumptions)**: Using only the original
    problem hypotheses (convex f, locally Lipschitz ∇f, minimizer exists) and
    the concrete min stepsize rule, the weighted average satisfies
    f(x̂_k) - f* ≤ D/(2·S_k) ≤ D/(2·k·c) where c = min{λ₁, 1/(2L)}.

    The uniform L is obtained from local Lipschitz + iterate boundedness; it is
    not added as a final assumption. -/
theorem rate_theorem_from_local (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (hloc : GradientLocallyLipschitz f') :
    ∃ L > 0, ∀ k ≥ 1,
      f (weighted_average alg k) - f xstar ≤
        rate_constant alg xstar / (2 * total_weight alg k) ∧
      rate_constant alg xstar / (2 * total_weight alg k) ≤
        rate_constant alg xstar / (2 * ↑k * min (alg.la 1) (1 / (2 * L))) := by
  obtain ⟨L, hL_pos, hlip⟩ := uniform_lipschitz_from_iterates hloc alg xstar hmin
  refine ⟨L, hL_pos, ?_⟩
  intro k hk
  exact rate_theorem alg hr xstar hmin L hL_pos hlip k hk

/-! ## Convergence Preparation: Gradient at Minimizer and Smooth Convex Inequality -/

set_option linter.unusedSectionVars false in
/-- At a minimizer of a differentiable function, the gradient is zero.
    This uses only differentiability (HasGradientAt) and the minimizer condition,
    not continuity of f'. -/
theorem gradient_zero_at_minimizer (alg : AdGD f f') (xstar : E)
    (hmin : IsMinOn f Set.univ xstar) : f' xstar = 0 := by
  have hdiff : HasGradientAt f (f' xstar) xstar := alg.diff xstar
  have hfd : HasFDerivAt f (toDual ℝ E (f' xstar)) xstar := hdiff.hasFDerivAt
  have huniv_nhds : (Set.univ : Set E) ∈ nhds xstar := Filter.univ_mem
  have hlocalmin : IsLocalMin f xstar := hmin.isLocalMin huniv_nhds
  have hzero : toDual ℝ E (f' xstar) = 0 := hlocalmin.hasFDerivAt_eq_zero hfd
  have hmapz : toDual ℝ E (0 : E) = 0 := map_zero _
  exact (toDual ℝ E).injective (hzero.trans hmapz.symm)

/-! ## Convergence: Descent Lemma and Smooth Convex Inequality -/

set_option linter.unusedSectionVars false in
/-- Local descent lemma: if ∇f is L-Lipschitz on the segment [x, y],
    then f(y) ≤ f(x) + ⟨∇f(x), y−x⟩ + (L/2)‖y−x‖². -/
theorem local_descent_lemma
    (hd : ∀ z, HasGradientAt f (f' z) z)
    (L : ℝ) (hL : 0 ≤ L)
    (x y : E)
    (hlip_seg : ∀ t₁ t₂ : ℝ, t₁ ∈ Set.Icc 0 1 → t₂ ∈ Set.Icc 0 1 →
      ‖f' (x + t₁ • (y - x)) - f' (x + t₂ • (y - x))‖ ≤ L * ‖(t₁ - t₂) • (y - x)‖) :
    f y ≤ f x + ⟪f' x, y - x⟫_ℝ + L / 2 * ‖y - x‖ ^ 2 := by
  let g := fun t : ℝ ↦ f (x + t • (y - x))
  let g' := fun t : ℝ ↦ ⟪f' (x + t • (y - x)), y - x⟫_ℝ
  let LL := L * ‖y - x‖ ^ 2
  have gderiv : ∀ t₀ : ℝ, HasDerivAt g (g' t₀) t₀ := by
    intro t₀
    have hf' : ∀ z : E, HasFDerivAt f (toDual ℝ E (f' z)) z := fun z => (hd z).hasFDerivAt
    have hseg := deriv_function_comp_segment x y hf' t₀
    convert hseg using 1
  have glip : ∀ u v : ℝ, u ∈ Set.Icc 0 1 → v ∈ Set.Icc 0 1 →
      ‖g' u - g' v‖ ≤ L * ‖y - x‖ ^ 2 * ‖u - v‖ := by
    intro u v hu hv
    have heq : g' u - g' v = ⟪f' (x + u • (y - x)) - f' (x + v • (y - x)), y - x⟫_ℝ := by
      rw [inner_sub_left]
    have hcs : ‖g' u - g' v‖ ≤ ‖f' (x + u • (y - x)) - f' (x + v • (y - x))‖ * ‖y - x‖ := by
      rw [heq, Real.norm_eq_abs]
      exact abs_real_inner_le_norm _ _
    have hlip := hlip_seg u v hu hv
    have hnorm : ‖(u - v) • (y - x)‖ = ‖u - v‖ * ‖y - x‖ := by rw [norm_smul]
    rw [hnorm] at hlip
    calc ‖g' u - g' v‖
      ≤ ‖f' (x + u • (y - x)) - f' (x + v • (y - x))‖ * ‖y - x‖ := hcs
      _ ≤ (L * (‖u - v‖ * ‖y - x‖)) * ‖y - x‖ :=
          mul_le_mul_of_nonneg_right hlip (norm_nonneg _)
      _ = L * ‖y - x‖ ^ 2 * ‖u - v‖ := by ring
  let u := fun t₀ : ℝ ↦ g 0 + t₀ * (g' 0) + t₀ ^ 2 * (LL / 2)
  let u' := fun t : ℝ ↦ g' 0 + LL * t
  have hderiv : ∀ t, HasDerivAt u (u' t) t := by
    intro t
    show HasDerivAt u (g' 0 + LL * t) t
    have hLL : LL * t = (2 * t) * (LL / 2) := by field_simp
    rw [hLL]
    apply HasDerivAt.add
    · apply HasDerivAt.const_add
      · exact hasDerivAt_mul_const (g' 0)
    · apply HasDerivAt.mul_const
      have hd := HasDerivAt.pow (n := 2) (hasDerivAt_id' t)
      simp at hd; exact hd
  suffices h : g 1 ≤ u 1 by
    have h_g1 : g 1 = f y := by simp [g]
    have h_u1 : u 1 = f x + ⟪f' x, y - x⟫_ℝ + L / 2 * ‖y - x‖ ^ 2 := by
      simp [u, g, g', LL]; ring
    rw [h_g1, h_u1] at h; exact h
  have hbound := @image_le_of_deriv_right_le_deriv_boundary g g' 0 1
    (HasDerivAt.continuousOn (fun _ _ ↦ gderiv _))
    (fun t _ ↦ HasDerivAt.hasDerivWithinAt (gderiv t))
    u u'
    (by simp [u])
    (HasDerivAt.continuousOn (fun _ _ ↦ hderiv _))
    (fun t _ ↦ HasDerivAt.hasDerivWithinAt (hderiv t))
    (by
      intro t ht
      show g' t ≤ g' 0 + LL * t
      have ht0 : t ∈ Set.Icc 0 1 := ⟨ht.1, le_of_lt ht.2⟩
      have h0 : (0 : ℝ) ∈ Set.Icc 0 1 := by simp
      have hlip_t0 := glip t 0 ht0 h0
      simp only [Real.norm_eq_abs, sub_zero] at hlip_t0
      rw [abs_of_nonneg ht.1] at hlip_t0
      have hle : g' t - g' 0 ≤ |g' t - g' 0| := le_abs_self _
      linarith [hlip_t0, hle])
  exact hbound (by simp : (1 : ℝ) ∈ Set.Icc 0 1)

set_option linter.unusedSectionVars false in
/-- Smooth convex inequality at the minimizer (Lemma 3 specialization):
    (1/(2L)) * ‖∇f(x_k)‖² ≤ f(x_k) - f(x*). -/
theorem smooth_convex_ineq_at_min (alg : AdGD f f') (xstar : E)
    (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0)
    (R : ℝ) (hR : 0 ≤ R)
    (hiter_in_ball : ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R)
    (hlip_ball : ∀ a b, ‖a - xstar‖ ≤ 2 * R → ‖b - xstar‖ ≤ 2 * R →
      ‖f' a - f' b‖ ≤ L * ‖a - b‖) :
    ∀ n : ℕ, 1 / (2 * L) * ‖f' (alg.x n)‖ ^ 2 ≤ f (alg.x n) - f xstar := by
  have hf'star : f' xstar = 0 := gradient_zero_at_minimizer alg xstar hmin
  intro n
  set xk := alg.x n
  set zk := xk - (1 / L) • f' xk
  have hgrad_eq : f' xk = f' xk - f' xstar := by rw [hf'star]; abel
  have hxk_in_ball : ‖xk - xstar‖ ≤ R := hiter_in_ball n
  have hxk_in_2ball : ‖xk - xstar‖ ≤ 2 * R := by linarith
  have hxstar_in_2ball : ‖xstar - xstar‖ ≤ 2 * R := by simp; linarith
  have hgrad_lip : ‖f' xk - f' xstar‖ ≤ L * ‖xk - xstar‖ :=
    hlip_ball xk xstar hxk_in_2ball hxstar_in_2ball
  rw [← hgrad_eq] at hgrad_lip
  have hzk_norm : ‖zk - xk‖ = (1 / L) * ‖f' xk‖ := by
    have heq : zk - xk = -(1 / L) • f' xk := by
      show (xk - (1 / L) • f' xk) - xk = -(1 / L) • f' xk
      rw [neg_smul]; abel
    rw [heq, norm_smul, Real.norm_eq_abs]
    rw [show |-(1 / L : ℝ)| = 1 / L by rw [abs_neg, abs_of_pos (by positivity)]]
  have hzk_in_2ball : ‖zk - xstar‖ ≤ 2 * R := by
    have htri : ‖zk - xstar‖ ≤ ‖zk - xk‖ + ‖xk - xstar‖ := by
      rw [show zk - xstar = (zk - xk) + (xk - xstar) by abel]
      exact norm_add_le _ _
    have hzk_xk : ‖zk - xk‖ ≤ ‖xk - xstar‖ := by
      rw [hzk_norm]
      calc (1 / L) * ‖f' xk‖ ≤ (1 / L) * (L * ‖xk - xstar‖) :=
          mul_le_mul_of_nonneg_left hgrad_lip (by positivity)
        _ = ‖xk - xstar‖ := by field_simp
    calc ‖zk - xstar‖ ≤ ‖zk - xk‖ + ‖xk - xstar‖ := htri
      _ ≤ ‖xk - xstar‖ + ‖xk - xstar‖ := by linarith [hzk_xk]
      _ ≤ 2 * R := by linarith [hxk_in_ball]
  have hlip_seg : ∀ t₁ t₂ : ℝ, t₁ ∈ Set.Icc 0 1 → t₂ ∈ Set.Icc 0 1 →
      ‖f' (xk + t₁ • (zk - xk)) - f' (xk + t₂ • (zk - xk))‖ ≤ L * ‖(t₁ - t₂) • (zk - xk)‖ := by
    intro t₁ t₂ ht₁ ht₂
    have hpt₁ : ‖(xk + t₁ • (zk - xk)) - xstar‖ ≤ 2 * R := by
      have hdecomp : (xk + t₁ • (zk - xk)) - xstar =
          (1 - t₁) • (xk - xstar) + t₁ • (zk - xstar) := by module
      rw [hdecomp]
      have h1nn : 0 ≤ 1 - t₁ := sub_nonneg.mpr ht₁.2
      have h2nn : 0 ≤ t₁ := ht₁.1
      calc ‖(1 - t₁) • (xk - xstar) + t₁ • (zk - xstar)‖
          ≤ ‖(1 - t₁) • (xk - xstar)‖ + ‖t₁ • (zk - xstar)‖ := norm_add_le _ _
        _ = |1 - t₁| * ‖xk - xstar‖ + |t₁| * ‖zk - xstar‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ (1 - t₁) * (2 * R) + t₁ * (2 * R) := by
          rw [abs_of_nonneg h1nn, abs_of_nonneg h2nn]
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left hxk_in_2ball h1nn
          · exact mul_le_mul_of_nonneg_left hzk_in_2ball h2nn
        _ = 2 * R := by ring
    have hpt₂ : ‖(xk + t₂ • (zk - xk)) - xstar‖ ≤ 2 * R := by
      have hdecomp : (xk + t₂ • (zk - xk)) - xstar =
          (1 - t₂) • (xk - xstar) + t₂ • (zk - xstar) := by module
      rw [hdecomp]
      have h1nn : 0 ≤ 1 - t₂ := sub_nonneg.mpr ht₂.2
      have h2nn : 0 ≤ t₂ := ht₂.1
      calc ‖(1 - t₂) • (xk - xstar) + t₂ • (zk - xstar)‖
          ≤ ‖(1 - t₂) • (xk - xstar)‖ + ‖t₂ • (zk - xstar)‖ := norm_add_le _ _
        _ = |1 - t₂| * ‖xk - xstar‖ + |t₂| * ‖zk - xstar‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ (1 - t₂) * (2 * R) + t₂ * (2 * R) := by
          rw [abs_of_nonneg h1nn, abs_of_nonneg h2nn]
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left hxk_in_2ball h1nn
          · exact mul_le_mul_of_nonneg_left hzk_in_2ball h2nn
        _ = 2 * R := by ring
    have hdiff : (xk + t₁ • (zk - xk)) - (xk + t₂ • (zk - xk)) = (t₁ - t₂) • (zk - xk) := by
      module
    have hlip := hlip_ball _ _ hpt₁ hpt₂
    rw [hdiff] at hlip
    exact hlip
  have hdescent : f zk ≤ f xk + ⟪f' xk, zk - xk⟫_ℝ + L / 2 * ‖zk - xk‖ ^ 2 :=
    local_descent_lemma alg.diff L hL.le xk zk hlip_seg
  have hzk_xk : zk - xk = -(1 / L) • f' xk := by
    show (xk - (1 / L) • f' xk) - xk = -(1 / L) • f' xk
    rw [neg_smul]; abel
  have hinner : ⟪f' xk, zk - xk⟫_ℝ = -(1 / L) * ‖f' xk‖ ^ 2 := by
    rw [hzk_xk, real_inner_smul_right, real_inner_self_eq_norm_sq]
  have hdist_sq : ‖zk - xk‖ ^ 2 = (1 / L ^ 2) * ‖f' xk‖ ^ 2 := by
    rw [hzk_norm, mul_pow, div_pow, one_pow]
  have hfstar_le_fzk : f xstar ≤ f zk := hmin (mem_univ zk)
  have hsimp : L / 2 * (1 / L ^ 2) * ‖f' xk‖ ^ 2 = 1 / (2 * L) * ‖f' xk‖ ^ 2 := by
    field_simp
  have hcombined : f xstar ≤ f xk - 1 / (2 * L) * ‖f' xk‖ ^ 2 := by
    have h1 := hdescent
    rw [hinner, hdist_sq] at h1
    have hrw : (f xk + -(1 / L) * ‖f' xk‖ ^ 2) + L / 2 * (1 / L ^ 2 * ‖f' xk‖ ^ 2)
        = f xk - 1 / (2 * L) * ‖f' xk‖ ^ 2 := by
      have hLne : L ≠ 0 := ne_of_gt hL
      field_simp; ring
    rw [hrw] at h1
    linarith [hfstar_le_fzk, h1]
  linarith

set_option linter.unusedSectionVars false in
/-- Co-coercivity of the gradient (Lemma 3 with y = x_k, x = x*):
    f(x*) - f(x_k) - ⟨∇f(x_k), x* - x_k⟩ ≥ (1/(2L))‖∇f(x_k)‖².

    This is the key inequality that strengthens the energy inequality.
    Proof: apply the descent lemma at x* with z = x* + (1/L)∇f(x_k),
    and use convexity to bound f(z) from below. -/
theorem cocoercivity_at_min (alg : AdGD f f') (xstar : E)
    (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0)
    (R : ℝ) (hR : 0 ≤ R)
    (hiter_in_ball : ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R)
    (hlip_ball : ∀ a b, ‖a - xstar‖ ≤ 2 * R → ‖b - xstar‖ ≤ 2 * R →
      ‖f' a - f' b‖ ≤ L * ‖a - b‖) :
    ∀ n : ℕ, f xstar - f (alg.x n) - ⟪f' (alg.x n), xstar - alg.x n⟫_ℝ
      ≥ 1 / (2 * L) * ‖f' (alg.x n)‖ ^ 2 := by
  have hf'star : f' xstar = 0 := gradient_zero_at_minimizer alg xstar hmin
  intro n
  set xk := alg.x n
  set z := xstar + (1 / L) • f' xk
  have hxk_in_ball : ‖xk - xstar‖ ≤ R := hiter_in_ball n
  have hxk_in_2ball : ‖xk - xstar‖ ≤ 2 * R := by linarith
  have hxstar_in_2ball : ‖xstar - xstar‖ ≤ 2 * R := by simp; linarith
  have hgrad_lip : ‖f' xk - f' xstar‖ ≤ L * ‖xk - xstar‖ :=
    hlip_ball xk xstar hxk_in_2ball hxstar_in_2ball
  rw [show f' xk - f' xstar = f' xk by rw [hf'star]; abel] at hgrad_lip
  have hz_norm : ‖z - xstar‖ = (1 / L) * ‖f' xk‖ := by
    have heq : z - xstar = (1 / L) • f' xk := by
      show (xstar + (1 / L) • f' xk) - xstar = (1 / L) • f' xk
      abel
    rw [heq, norm_smul, Real.norm_eq_abs]
    rw [show |1 / L| = 1 / L by rw [abs_of_pos (by positivity)]]
  have hz_in_2ball : ‖z - xstar‖ ≤ 2 * R := by
    rw [hz_norm]
    calc (1 / L) * ‖f' xk‖ ≤ (1 / L) * (L * ‖xk - xstar‖) :=
        mul_le_mul_of_nonneg_left hgrad_lip (by positivity)
      _ = ‖xk - xstar‖ := by field_simp
      _ ≤ 2 * R := hxk_in_2ball
  have hlip_seg : ∀ t₁ t₂ : ℝ, t₁ ∈ Set.Icc 0 1 → t₂ ∈ Set.Icc 0 1 →
      ‖f' (xstar + t₁ • (z - xstar)) - f' (xstar + t₂ • (z - xstar))‖
      ≤ L * ‖(t₁ - t₂) • (z - xstar)‖ := by
    intro t₁ t₂ ht₁ ht₂
    have hpt₁ : ‖(xstar + t₁ • (z - xstar)) - xstar‖ ≤ 2 * R := by
      have hdecomp : (xstar + t₁ • (z - xstar)) - xstar = t₁ • (z - xstar) := by abel
      rw [hdecomp, norm_smul, Real.norm_eq_abs]
      rw [abs_of_nonneg ht₁.1]
      calc t₁ * ‖z - xstar‖ ≤ 1 * ‖z - xstar‖ := mul_le_mul_of_nonneg_right ht₁.2 (norm_nonneg _)
        _ = ‖z - xstar‖ := by rw [one_mul]
        _ ≤ 2 * R := hz_in_2ball
    have hpt₂ : ‖(xstar + t₂ • (z - xstar)) - xstar‖ ≤ 2 * R := by
      have hdecomp : (xstar + t₂ • (z - xstar)) - xstar = t₂ • (z - xstar) := by abel
      rw [hdecomp, norm_smul, Real.norm_eq_abs]
      rw [abs_of_nonneg ht₂.1]
      calc t₂ * ‖z - xstar‖ ≤ 1 * ‖z - xstar‖ := mul_le_mul_of_nonneg_right ht₂.2 (norm_nonneg _)
        _ = ‖z - xstar‖ := by rw [one_mul]
        _ ≤ 2 * R := hz_in_2ball
    have hdiff : (xstar + t₁ • (z - xstar)) - (xstar + t₂ • (z - xstar))
        = (t₁ - t₂) • (z - xstar) := by module
    have hlip := hlip_ball _ _ hpt₁ hpt₂
    rw [hdiff] at hlip
    exact hlip
  have hdescent : f z ≤ f xstar + ⟪f' xstar, z - xstar⟫_ℝ + L / 2 * ‖z - xstar‖ ^ 2 :=
    local_descent_lemma alg.diff L hL.le xstar z hlip_seg
  rw [hf'star, inner_zero_left, add_zero] at hdescent
  rw [hz_norm, mul_pow, div_pow, one_pow] at hdescent
  have hdescent' : f z ≤ f xstar + 1 / (2 * L) * ‖f' xk‖ ^ 2 := by
    have hLne : L ≠ 0 := ne_of_gt hL
    have : L / 2 * (1 / L ^ 2 * ‖f' xk‖ ^ 2) = 1 / (2 * L) * ‖f' xk‖ ^ 2 := by field_simp
    rw [this] at hdescent
    exact hdescent
  have hconv : f xk + ⟪f' xk, z - xk⟫_ℝ ≤ f z := by
    linarith [convex_ineq alg xk z]
  have hz_xk : z - xk = (xstar - xk) + (1 / L) • f' xk := by
    show (xstar + (1 / L) • f' xk) - xk = (xstar - xk) + (1 / L) • f' xk
    abel
  rw [hz_xk, inner_add_right, real_inner_smul_right, real_inner_self_eq_norm_sq] at hconv
  have hcombined : f xk + ⟪f' xk, xstar - xk⟫_ℝ + 1 / L * ‖f' xk‖ ^ 2
      ≤ f xstar + 1 / (2 * L) * ‖f' xk‖ ^ 2 := by linarith [hconv, hdescent']
  have hLne : L ≠ 0 := ne_of_gt hL
  have : 1 / L * ‖f' xk‖ ^ 2 - 1 / (2 * L) * ‖f' xk‖ ^ 2 = 1 / (2 * L) * ‖f' xk‖ ^ 2 := by
    field_simp; ring
  linarith [hcombined, this]

set_option linter.unusedSectionVars false in
/-- Bad term bound: the "bad" term ‖x_{k+1} - x_k‖² is controlled by
    (1/2)‖x_k - x_{k-1}‖² - (1/2)‖x_{k+1} - x_k‖² + 2λ_kθ_k(f(x_{k-1}) - f(x_k)).
    This is extracted from the energy inequality proof for reuse. -/
lemma bad_term_bound (alg : AdGD f f') (k : ℕ) (hk : k ≥ 1) :
    ‖alg.x (k + 1) - alg.x k‖ ^ 2
      ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        - (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) := by
  have hla : alg.la k > 0 := alg.la_pos k
  have hlam1 : alg.la (k - 1) > 0 := alg.la_pos (k - 1)
  have hth : theta alg.la k = alg.la k / alg.la (k - 1) := algTheta_def k hk
  have hd2 : alg.x (k + 1) - alg.x k = - alg.la k • f' (alg.x k) := update_diff k
  have hneg_d2 : alg.x k - alg.x (k + 1) = alg.la k • f' (alg.x k) := update_diff' k
  have hprev : alg.x (k - 1) - alg.x k = alg.la (k - 1) • f' (alg.x (k - 1)) :=
    prev_update_diff k hk
  have hconv_prev : ⟪f' (alg.x k), alg.x (k - 1) - alg.x k⟫_ℝ
      ≤ f (alg.x (k - 1)) - f (alg.x k) := by
    linarith [convex_ineq alg (alg.x k) (alg.x (k - 1))]
  have hd2_sq : ‖alg.x (k + 1) - alg.x k‖ ^ 2 = alg.la k ^ 2 * ‖f' (alg.x k)‖ ^ 2 := by
    rw [hd2]
    simp only [norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hla, mul_pow]
  have hident : ‖alg.x (k + 1) - alg.x k‖ ^ 2
      = 2 * alg.la k * ⟪f' (alg.x k), alg.x k - alg.x (k + 1)⟫_ℝ
        - ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    rw [hneg_d2, real_inner_smul_right, real_inner_self_eq_norm_sq, hd2_sq]
    ring
  have hsplit : 2 * alg.la k * ⟪f' (alg.x k), alg.x k - alg.x (k + 1)⟫_ℝ
      = 2 * alg.la k * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        + 2 * alg.la k * ⟪f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ := by
    rw [inner_sub_left]; ring
  have hbound1 : 2 * alg.la k
      * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
      ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    have hcs : ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        ≤ ‖f' (alg.x k) - f' (alg.x (k - 1))‖ * ‖alg.x k - alg.x (k + 1)‖ :=
      real_inner_le_norm _ _
    have hstep := alg.stepsize_curvature k hk
    have h1 : 2 * alg.la k
        * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
        ≤ ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖ := by
      calc 2 * alg.la k
          * ⟪f' (alg.x k) - f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
          ≤ 2 * alg.la k * (‖f' (alg.x k) - f' (alg.x (k - 1))‖ * ‖alg.x k - alg.x (k + 1)‖) :=
            mul_le_mul_of_nonneg_left hcs (by positivity)
        _ = (2 * alg.la k * ‖f' (alg.x k) - f' (alg.x (k - 1))‖) * ‖alg.x k - alg.x (k + 1)‖ :=
            by ring
        _ ≤ ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖ :=
            mul_le_mul_of_nonneg_right hstep (norm_nonneg _)
    have hnorm_comm : ‖alg.x k - alg.x (k + 1)‖ = ‖alg.x (k + 1) - alg.x k‖ := by
      have : alg.x k - alg.x (k + 1) = -(alg.x (k + 1) - alg.x k) := by abel
      rw [this, norm_neg]
    have hyoung : ‖alg.x k - alg.x (k - 1)‖ * ‖alg.x k - alg.x (k + 1)‖
        ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
          + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
      rw [hnorm_comm]
      have hsq : 0 ≤ (‖alg.x k - alg.x (k - 1)‖ - ‖alg.x (k + 1) - alg.x k‖) ^ 2 :=
        sq_nonneg _
      nlinarith [hsq]
    linarith
  have hbound2 : 2 * alg.la k * ⟪f' (alg.x (k - 1)), alg.x k - alg.x (k + 1)⟫_ℝ
      ≤ 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) := by
    rw [hneg_d2, real_inner_smul_right]
    have hkey : alg.la k * ⟪f' (alg.x (k - 1)), f' (alg.x k)⟫_ℝ
        = theta alg.la k * ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ := by
      rw [hth, hprev, real_inner_smul_left]
      field_simp
    rw [hkey]
    have hth_pos : 0 < theta alg.la k := by rw [hth]; positivity
    have hconv_prev' : ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ
        ≤ f (alg.x (k - 1)) - f (alg.x k) := by
      rw [real_inner_comm]; exact hconv_prev
    have h1 : theta alg.la k * ⟪alg.x (k - 1) - alg.x k, f' (alg.x k)⟫_ℝ
        ≤ theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k)) :=
      mul_le_mul_of_nonneg_left hconv_prev' (le_of_lt hth_pos)
    have h2la_pos : 0 ≤ 2 * alg.la k := by positivity
    rw [show 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
        = 2 * alg.la k * (theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))) by ring]
    exact mul_le_mul_of_nonneg_left h1 h2la_pos
  rw [hident, hsplit]
  linarith [hbound1, hbound2]

set_option linter.unusedSectionVars false in
/-- **Improved energy inequality** (equation 15): the energy inequality strengthened
    with an extra (λ_k/L)‖∇f(x_k)‖² term on the LHS, using co-coercivity. -/
theorem improved_energy_inequality (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0) (R : ℝ) (hR : 0 ≤ R)
    (hiter_in_ball : ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R)
    (hlip_ball : ∀ a b, ‖a - xstar‖ ≤ 2 * R → ‖b - xstar‖ ≤ 2 * R →
      ‖f' a - f' b‖ ≤ L * ‖a - b‖)
    (k : ℕ) (hk : k ≥ 1) :
    ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
      + 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
      + alg.la k / L * ‖f' (alg.x k)‖ ^ 2
    ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
      + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar) := by
  have hla : alg.la k > 0 := alg.la_pos k
  have hd2 : alg.x (k + 1) - alg.x k = - alg.la k • f' (alg.x k) := update_diff k
  -- Co-coercivity: ⟨f'(x_k), x* - x_k⟩ ≤ (f(x*) - f(x_k)) - (1/(2L))‖f'(x_k)‖²
  have hcoco := cocoercivity_at_min alg xstar hmin L hL R hR hiter_in_ball hlip_ball k
  -- Expand ‖x_{k+1} - x*‖²
  have hexpand : ‖alg.x (k + 1) - xstar‖ ^ 2 =
      ‖alg.x k - xstar‖ ^ 2 + 2 * ⟪alg.x k - xstar, alg.x (k + 1) - alg.x k⟫_ℝ
      + ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    have hdecomp : alg.x (k + 1) - xstar = (alg.x k - xstar) + (alg.x (k + 1) - alg.x k) := by
      abel
    rw [hdecomp, norm_add_sq_real]
  have hinner : 2 * ⟪alg.x k - xstar, alg.x (k + 1) - alg.x k⟫_ℝ
      = 2 * alg.la k * ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ := by
    rw [hd2, real_inner_smul_right]
    have hswap : ⟪alg.x k - xstar, f' (alg.x k)⟫_ℝ = -⟪f' (alg.x k), xstar - alg.x k⟫_ℝ := by
      rw [inner_sub_left, inner_sub_right]
      have hcomm1 : ⟪alg.x k, f' (alg.x k)⟫_ℝ = ⟪f' (alg.x k), alg.x k⟫_ℝ :=
        real_inner_comm _ _
      have hcomm2 : ⟪xstar, f' (alg.x k)⟫_ℝ = ⟪f' (alg.x k), xstar⟫_ℝ :=
        real_inner_comm _ _
      rw [hcomm1, hcomm2]; ring
    rw [hswap]; ring
  -- Improved step 4: with extra -(λ_k/L)‖f'(x_k)‖²
  have hstep4 : ‖alg.x (k + 1) - xstar‖ ^ 2 ≤
      ‖alg.x k - xstar‖ ^ 2 - 2 * alg.la k * (f (alg.x k) - f xstar)
      - alg.la k / L * ‖f' (alg.x k)‖ ^ 2
      + ‖alg.x (k + 1) - alg.x k‖ ^ 2 := by
    rw [hexpand, hinner]
    have hmul : 2 * alg.la k * ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ
        ≤ 2 * alg.la k * (f xstar - f (alg.x k)) - alg.la k / L * ‖f' (alg.x k)‖ ^ 2 := by
      have hLne : L ≠ 0 := ne_of_gt hL
      have : 2 * alg.la k * ((f xstar - f (alg.x k)) - 1 / (2 * L) * ‖f' (alg.x k)‖ ^ 2)
          = 2 * alg.la k * (f xstar - f (alg.x k)) - alg.la k / L * ‖f' (alg.x k)‖ ^ 2 := by
        ring
      have h1 : ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ
          ≤ (f xstar - f (alg.x k)) - 1 / (2 * L) * ‖f' (alg.x k)‖ ^ 2 := by linarith [hcoco]
      have h2 : 2 * alg.la k * ⟪f' (alg.x k), xstar - alg.x k⟫_ℝ
          ≤ 2 * alg.la k * ((f xstar - f (alg.x k)) - 1 / (2 * L) * ‖f' (alg.x k)‖ ^ 2) :=
        mul_le_mul_of_nonneg_left h1 (by positivity)
      linarith [h2, this]
    linarith
  -- Bad term bound (same as original)
  have hbad := bad_term_bound alg k hk
  -- Combine
  have hgoal : ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
      + 2 * alg.la k * (f (alg.x k) - f xstar)
      + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar)
      + alg.la k / L * ‖f' (alg.x k)‖ ^ 2
    ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
      + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
      + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar) := by
    linarith [hstep4, hbad]
  calc ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
        + alg.la k / L * ‖f' (alg.x k)‖ ^ 2
      = ‖alg.x (k + 1) - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x (k + 1) - alg.x k‖ ^ 2
        + 2 * alg.la k * (f (alg.x k) - f xstar)
        + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar)
        + alg.la k / L * ‖f' (alg.x k)‖ ^ 2 := by ring
    _ ≤ ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f (alg.x k))
        + 2 * alg.la k * theta alg.la k * (f (alg.x k) - f xstar) := hgoal
    _ = ‖alg.x k - xstar‖ ^ 2 + (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2
        + 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar) := by ring

/-! ## Convergence: Gradient tends to zero -/

set_option linter.unusedSectionVars false in
/-- Improved energy step: E_{k+1} + 2w_k(f(x_k)-f*) + (λ_k/L)‖f'(x_k)‖² ≤ E_k. -/
lemma improved_energy_step (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0) (R : ℝ) (hR : 0 ≤ R)
    (hiter_in_ball : ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R)
    (hlip_ball : ∀ a b, ‖a - xstar‖ ≤ 2 * R → ‖b - xstar‖ ≤ 2 * R →
      ‖f' a - f' b‖ ≤ L * ‖a - b‖)
    (k : ℕ) (hk : k ≥ 1) :
    energy alg xstar (k + 1) + 2 * weight alg k * (f (alg.x k) - f xstar)
      + alg.la k / L * ‖f' (alg.x k)‖ ^ 2 ≤
    energy alg xstar k := by
  have hei := improved_energy_inequality alg xstar hmin L hL R hR hiter_in_ball hlip_ball k hk
  have hwk : 2 * alg.la k * (1 + theta alg.la k) * (f (alg.x k) - f xstar)
      = 2 * alg.la (k + 1) * theta alg.la (k + 1) * (f (alg.x k) - f xstar)
        + 2 * weight alg k * (f (alg.x k) - f xstar) := by
    rw [weight]; ring
  rw [hwk] at hei
  unfold energy
  have hksub : k + 1 - 1 = k := by omega
  rw [hksub]
  linarith [hei]

set_option linter.unusedSectionVars false in
/-- Strengthened telescoping: sum + E_{N+1} ≤ D for all N. -/
theorem gradient_telescoping_strong (alg : AdGD f f') (xstar : E)
    (hmin : IsMinOn f Set.univ xstar)
    (L : ℝ) (hL : L > 0) (R : ℝ) (hR : 0 ≤ R)
    (hiter_in_ball : ∀ n : ℕ, ‖alg.x n - xstar‖ ≤ R)
    (hlip_ball : ∀ a b, ‖a - xstar‖ ≤ 2 * R → ‖b - xstar‖ ≤ 2 * R →
      ‖f' a - f' b‖ ≤ L * ‖a - b‖)
    (N : ℕ) :
    ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2)
      + energy alg xstar (N + 1) ≤ rate_constant alg xstar := by
  induction N with
  | zero =>
    have hE1_eq : energy alg xstar 1 = rate_constant alg xstar := by
      simp [energy, rate_constant]
    simp [Finset.range, hE1_eq]
  | succ N ih =>
    rw [Finset.sum_range_succ]
    have hNp1_ne0 : N + 1 ≠ 0 := by omega
    simp [hNp1_ne0]
    have hNp1_ge1 : N + 1 ≥ 1 := by omega
    have hstep := improved_energy_step alg xstar hmin L hL R hR hiter_in_ball hlip_ball
      (N + 1) hNp1_ge1
    -- From hstep: E_{N+2} + 2w_{N+1}(f(x_{N+1})-f*) + (λ_{N+1}/L)‖f'‖² ≤ E_{N+1}
    -- So: (λ_{N+1}/L)‖f'‖² ≤ E_{N+1} - E_{N+2}
    have hfx_nn : 0 ≤ f (alg.x (N + 1)) - f xstar := by
      have h := hmin (mem_univ (alg.x (N + 1))); simpa using h
    have hw_nn : 0 ≤ weight alg (N + 1) := weight_nonneg alg (N + 1) hNp1_ge1
    have hextra : 0 ≤ 2 * weight alg (N + 1) * (f (alg.x (N + 1)) - f xstar) :=
      mul_nonneg (mul_nonneg (by norm_num) hw_nn) hfx_nn
    -- ih: sum_N + E_{N+1} ≤ D
    -- hstep: E_{N+2} + extra + (λ_{N+1}/L)‖f'‖² ≤ E_{N+1}
    -- So: sum_N + (λ_{N+1}/L)‖f'‖² + E_{N+2} ≤ sum_N + E_{N+1} ≤ D
    have : ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2)
        + alg.la (N + 1) / L * ‖f' (alg.x (N + 1))‖ ^ 2 + energy alg xstar (N + 1 + 1)
      ≤ rate_constant alg xstar := by
      have hgrad_le : alg.la (N + 1) / L * ‖f' (alg.x (N + 1))‖ ^ 2
          ≤ energy alg xstar (N + 1) - energy alg xstar (N + 1 + 1) := by linarith [hstep, hextra]
      have : ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2)
          + (energy alg xstar (N + 1) - energy alg xstar (N + 1 + 1))
          + energy alg xstar (N + 1 + 1)
        ≤ rate_constant alg xstar := by linarith [ih]
      linarith [this, hgrad_le]
    exact this

set_option linter.unusedSectionVars false in
/-- **Gradient tends to zero**: ‖∇f(x_k)‖ → 0 as k → ∞. -/
theorem gradient_tendsto_zero (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (hloc : GradientLocallyLipschitz f') :
    Filter.Tendsto (fun n => ‖f' (alg.x n)‖) Filter.atTop (nhds 0) := by
  -- Get boundedness
  obtain ⟨R, hR_nn, hR⟩ := all_iterates_bounded alg xstar hmin
  -- Get uniform L from local Lipschitz on 2R ball
  obtain ⟨L, hL_pos, hLip_ball⟩ := hloc xstar (2 * R) (by linarith)
  -- Get global Lipschitz on iterates (for stepsize lower bound)
  have hlip : ∀ n m : ℕ, ‖f' (alg.x n) - f' (alg.x m)‖ ≤ L * ‖alg.x n - alg.x m‖ := by
    intro n m
    exact hLip_ball (alg.x n) (alg.x m)
      (le_trans (hR n) (by linarith)) (le_trans (hR m) (by linarith))
  -- Stepsize lower bound: λ_k ≥ c = min{λ_1, 1/(2L)}
  set c := min (alg.la 1) (1 / (2 * L))
  have hc_pos : 0 < c := lt_min (alg.la_pos 1) (by positivity)
  have hlb : ∀ k ≥ 1, alg.la k ≥ c := stepsize_lower_bound alg hr L hL_pos hlip
  -- Strengthened telescoping: sum + E_{N+1} ≤ D, so sum ≤ D
  have hstrong := gradient_telescoping_strong alg xstar hmin L hL_pos R hR_nn hR hLip_ball
  -- Bounded partial sums of (λ_k/L)‖f'(x_k)‖²
  have hsum_bound : ∀ N,
      ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2)
      ≤ rate_constant alg xstar := by
    intro N
    have hs := hstrong N
    have hfx : 0 ≤ f (alg.x N) - f xstar := by
      have h := hmin (mem_univ (alg.x N)); simpa using h
    have hEnn : 0 ≤ energy alg xstar (N + 1) := by
      unfold energy
      have hksub : N + 1 - 1 = N := by omega
      rw [hksub]
      have hth : 0 ≤ theta alg.la (N + 1) := by
        rw [algTheta_def (N + 1) (by omega)]
        exact le_of_lt (div_pos (alg.la_pos (N + 1)) (alg.la_pos N))
      have h1 : 0 ≤ ‖alg.x (N + 1) - xstar‖ ^ 2 := sq_nonneg _
      have h2 : 0 ≤ (1/2 : ℝ) * ‖alg.x (N + 1) - alg.x N‖ ^ 2 := by positivity
      have h3 : 0 ≤ 2 * alg.la (N + 1) * theta alg.la (N + 1) * (f (alg.x N) - f xstar) := by
        exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (alg.la_pos (N + 1)).le) hth) hfx
      linarith [h1, h2, h3]
    linarith [hs, hEnn]
  -- Convert to bounded partial sums of ‖f'(x_k)‖² using λ_k ≥ c
  have hgrad_sq_bdd : ∀ N,
      ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else ‖f' (alg.x k)‖ ^ 2)
      ≤ L * rate_constant alg xstar / c := by
    intro N
    set S := ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else ‖f' (alg.x k)‖ ^ 2)
    have hkey : ∀ k ∈ Finset.range (N + 1),
        (if k = 0 then (0 : ℝ) else (c / L) * ‖f' (alg.x k)‖ ^ 2)
        ≤ (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2) := by
      intro k hk
      by_cases hk0 : k = 0
      · simp [hk0]
      · simp [hk0]
        have hlk : alg.la k ≥ c := hlb k (by simp [Finset.range] at hk; omega)
        have hclL : c / L ≤ alg.la k / L := by
          rw [div_le_div_iff₀ hL_pos hL_pos]
          exact mul_le_mul_of_nonneg_right hlk hL_pos.le
        exact mul_le_mul_of_nonneg_right hclL (sq_nonneg _)
    have hfactored :
        ∑ k ∈ Finset.range (N + 1), (if k = 0 then (0 : ℝ) else (c / L) * ‖f' (alg.x k)‖ ^ 2)
        = (c / L) * S := by
      rw [Finset.mul_sum]
      congr; ext k
      by_cases hk0 : k = 0
      · simp [hk0]
      · simp [hk0]
    have hcs : (c / L) * S ≤
        ∑ k ∈ Finset.range (N + 1),
          (if k = 0 then (0 : ℝ) else alg.la k / L * ‖f' (alg.x k)‖ ^ 2) := by
      rw [← hfactored]
      exact Finset.sum_le_sum hkey
    have hsum_le : (c / L) * S ≤ rate_constant alg xstar := by
      linarith [hcs, hsum_bound N]
    rw [le_div_iff₀ hc_pos]
    have hSc : S * c = L * ((c / L) * S) := by field_simp
    rw [hSc]
    exact mul_le_mul_of_nonneg_left hsum_le hL_pos.le
  -- Non-negative terms with bounded partial sums → summable → terms → 0
  have hnn : ∀ k, 0 ≤ ‖f' (alg.x k)‖ ^ 2 := fun k => sq_nonneg _
  have hrc_nn : 0 ≤ rate_constant alg xstar := by
    unfold rate_constant
    have ha : 0 ≤ ‖alg.x 1 - xstar‖ ^ 2 := sq_nonneg _
    have hb : 0 ≤ (1/2 : ℝ) * ‖alg.x 1 - alg.x 0‖ ^ 2 := by positivity
    have hth : 0 < theta alg.la 1 := by
      rw [algTheta_def 1 (by omega)]
      exact div_pos (alg.la_pos 1) (alg.la_pos 0)
    have hfx : 0 ≤ f (alg.x 0) - f xstar := by
      have h := hmin (mem_univ (alg.x 0)); simpa using h
    have hc0 : 0 ≤ 2 * alg.la 1 * theta alg.la 1 * (f (alg.x 0) - f xstar) := by
      exact mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (alg.la_pos 1).le) hth.le) hfx
    linarith [ha, hb, hc0]
  have hB : ∀ n, ∑ i ∈ Finset.range n, ‖f' (alg.x i)‖ ^ 2 ≤
      ‖f' (alg.x 0)‖ ^ 2 + L * rate_constant alg xstar / c := by
    intro n
    by_cases hn : n = 0
    · simp [hn, Finset.range]
      exact add_nonneg (hnn 0) (div_nonneg (mul_nonneg hL_pos.le hrc_nn) hc_pos.le)
    · have hnge1 : 1 ≤ n := by omega
      have hbdd := hgrad_sq_bdd (n - 1)
      have hnsub : (n - 1) + 1 = n := Nat.sub_add_cancel hnge1
      rw [hnsub] at hbdd
      have h0in : (0 : ℕ) ∈ Finset.range n := by simp only [Finset.mem_range]; omega
      rw [← Finset.add_sum_erase (Finset.range n) (fun k => ‖f' (alg.x k)‖ ^ 2) h0in]
      have hkey : ∑ k ∈ (Finset.range n).erase 0, ‖f' (alg.x k)‖ ^ 2 =
          ∑ k ∈ Finset.range n, (if k = 0 then (0 : ℝ) else ‖f' (alg.x k)‖ ^ 2) := by
        rw [← Finset.sdiff_singleton_eq_erase]
        have h0sub : ({0} : Finset ℕ) ⊆ Finset.range n := by
          intro x hx; simp only [Finset.mem_singleton, Finset.mem_range] at hx ⊢; omega
        rw [← Finset.sum_sdiff h0sub, Finset.sum_singleton]
        simp only [if_true, add_zero]
        apply Finset.sum_congr rfl
        intro i hi
        simp only [Finset.mem_sdiff, Finset.mem_singleton] at hi
        rw [if_neg hi.2]
      rw [hkey]
      linarith [hbdd]
  have hsummable : Summable fun k => ‖f' (alg.x k)‖ ^ 2 :=
    summable_of_sum_range_le hnn hB
  have hsq_zero : Filter.Tendsto (fun n => ‖f' (alg.x n)‖ ^ 2) Filter.atTop (nhds 0) :=
    hsummable.tendsto_atTop_zero
  -- ‖f'(x_k)‖ = sqrt(‖f'(x_k)‖²) → sqrt(0) = 0
  have hsqrt : Filter.Tendsto Real.sqrt (nhds 0) (nhds 0) := by
    simpa [Real.sqrt_zero] using Real.continuous_sqrt.tendsto (0 : ℝ)
  convert hsqrt.comp hsq_zero using 1
  funext n
  simp only [Function.comp_apply]
  rw [Real.sqrt_sq (norm_nonneg _)]

/-! ## Convergence: Cluster Point Optimality -/

set_option linter.unusedSectionVars false in
/-- Any cluster point of (x^k) is a minimizer of f.

If a subsequence (x^{φ(n)}) converges to x̄, then ∇f(x̄) = 0 (by Lipschitz
continuity of ∇f and ∇f(x^k) → 0), and convexity implies x̄ is a minimizer. -/
theorem cluster_point_is_minimizer (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (hloc : GradientLocallyLipschitz f') :
    ∀ xbar : E, (∃ φ : ℕ → ℕ, StrictMono φ ∧
      Filter.Tendsto (fun n => alg.x (φ n)) Filter.atTop (nhds xbar)) →
    IsMinOn f Set.univ xbar := by
  intro xbar ⟨φ, hφ_mono, hφ_tendsto⟩
  obtain ⟨R, hR_nn, hR⟩ := all_iterates_bounded alg xstar hmin
  obtain ⟨L, hL_pos, hLip_ball⟩ := hloc xstar (2 * R) (by linarith)
  have hgrad := gradient_tendsto_zero alg hr xstar hmin hloc
  have hφ_atTop : Filter.Tendsto φ Filter.atTop Filter.atTop :=
    StrictMono.tendsto_atTop hφ_mono
  have hsub_grad : Filter.Tendsto (fun n => ‖f' (alg.x (φ n))‖) Filter.atTop (nhds 0) :=
    hgrad.comp hφ_atTop
  have hdist_tendsto : Filter.Tendsto (fun n => ‖alg.x (φ n) - xstar‖) Filter.atTop
      (nhds ‖xbar - xstar‖) := by
    have hcont : Continuous (fun x : E => ‖x - xstar‖) := by continuity
    exact (hcont.tendsto xbar).comp hφ_tendsto
  have hbounds : ∀ᶠ n in Filter.atTop, ‖alg.x (φ n) - xstar‖ ∈ Set.Iic R :=
    Filter.eventually_atTop.mpr ⟨0, fun n _ => hR (φ n)⟩
  have hxR : ‖xbar - xstar‖ ≤ R :=
    isClosed_Iic.mem_of_tendsto hdist_tendsto hbounds
  have hxbar_ball : ‖xbar - xstar‖ ≤ 2 * R := by linarith
  have hftendsto : Filter.Tendsto (fun n => f' (alg.x (φ n))) Filter.atTop
      (nhds (f' xbar)) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    have hεL : 0 < ε / L := div_pos hε hL_pos
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp hφ_tendsto (ε / L) hεL
    refine ⟨N, ?_⟩
    intro n hn
    have hlip := hLip_ball (alg.x (φ n)) xbar
      (le_trans (hR (φ n)) (by linarith)) hxbar_ball
    have hNnorm : ‖alg.x (φ n) - xbar‖ < ε / L := by
      have heq := dist_eq_norm (alg.x (φ n)) xbar
      rw [← heq]; exact hN n hn
    rw [dist_eq_norm]
    calc ‖f' (alg.x (φ n)) - f' xbar‖
        ≤ L * ‖alg.x (φ n) - xbar‖ := hlip
      _ < L * (ε / L) := mul_lt_mul_of_pos_left hNnorm hL_pos
      _ = ε := by field_simp
  have hsub_grad_norm : Filter.Tendsto (fun n => ‖f' (alg.x (φ n))‖) Filter.atTop
      (nhds ‖f' xbar‖) := by
    have hcont : Continuous (fun x : E => ‖x‖) := by continuity
    exact (hcont.tendsto (f' xbar)).comp hftendsto
  have hnorm_eq : ‖f' xbar‖ = 0 :=
    (tendsto_nhds_unique hsub_grad hsub_grad_norm).symm
  have hf'bar : f' xbar = 0 := norm_eq_zero.mp hnorm_eq
  intro y hy
  have hconv := convex_ineq alg xbar y
  rw [hf'bar, inner_zero_left, add_zero] at hconv
  exact hconv

/-! ## Convergence: Function Values and Energy Limit -/

set_option linter.unusedSectionVars false in
/-- Function values converge to optimal: f(x_k) → f*. -/
theorem function_values_tendsto_optimal (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (hloc : GradientLocallyLipschitz f') :
    Filter.Tendsto (fun n => f (alg.x n) - f xstar) Filter.atTop (nhds 0) := by
  obtain ⟨R, hR_nn, hR⟩ := all_iterates_bounded alg xstar hmin
  obtain ⟨L, hL_pos, hLip_ball⟩ := hloc xstar (2 * R) (by linarith)
  have hgrad := gradient_tendsto_zero alg hr xstar hmin hloc
  have hcoco := cocoercivity_at_min alg xstar hmin L hL_pos R hR_nn hR hLip_ball
  have hupper : ∀ n, f (alg.x n) - f xstar ≤ R * ‖f' (alg.x n)‖ := by
    intro n
    have h := hcoco n
    have hinner : ⟪f' (alg.x n), alg.x n - xstar⟫_ℝ ≤ ‖f' (alg.x n)‖ * ‖alg.x n - xstar‖ :=
      real_inner_le_norm _ _
    have hneg : ⟪f' (alg.x n), alg.x n - xstar⟫_ℝ = -⟪f' (alg.x n), xstar - alg.x n⟫_ℝ := by
      rw [← neg_sub, inner_neg_right]
    have h1 : f (alg.x n) - f xstar ≤ ⟪f' (alg.x n), alg.x n - xstar⟫_ℝ := by
      rw [hneg]
      have hnn : 0 ≤ 1 / (2 * L) * ‖f' (alg.x n)‖ ^ 2 := by positivity
      linarith [h, hnn]
    calc f (alg.x n) - f xstar
        ≤ ⟪f' (alg.x n), alg.x n - xstar⟫_ℝ := h1
      _ ≤ ‖f' (alg.x n)‖ * ‖alg.x n - xstar‖ := hinner
      _ ≤ ‖f' (alg.x n)‖ * R := mul_le_mul_of_nonneg_left (hR n) (norm_nonneg _)
      _ = R * ‖f' (alg.x n)‖ := by ring
  have hlower : ∀ n, 0 ≤ f (alg.x n) - f xstar := by
    intro n
    have h := hmin (mem_univ (alg.x n)); simpa using h
  have hRmul : Filter.Tendsto (fun n => R * ‖f' (alg.x n)‖) Filter.atTop (nhds 0) := by
    have hc : Filter.Tendsto (fun _ : ℕ => R) Filter.atTop (nhds R) :=
      tendsto_nhds.mpr fun _ _ ha => Filter.univ_mem' fun _ => ha
    have key := hc.mul hgrad
    simpa [mul_zero] using key
  have hg0 : Filter.Tendsto (fun _ : ℕ => (0 : ℝ)) Filter.atTop (nhds 0) :=
    tendsto_nhds.mpr fun _ _ ha => Filter.univ_mem' fun _ => ha
  have hev_lower : ∀ᶠ n in Filter.atTop, (0 : ℝ) ≤ f (alg.x n) - f xstar :=
    Filter.Eventually.of_forall hlower
  have hev_upper : ∀ᶠ n in Filter.atTop, f (alg.x n) - f xstar ≤ R * ‖f' (alg.x n)‖ :=
    Filter.Eventually.of_forall hupper
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' hg0 hRmul hev_lower hev_upper

set_option linter.unusedSectionVars false in
/-- The energy E_k converges for any minimizer (non-increasing for k≥1 + bounded below by 0). -/
theorem energy_limit_exists (alg : AdGD f f') (xstar : E) (hmin : IsMinOn f Set.univ xstar) :
    ∃ E_inf : ℝ, Filter.Tendsto (fun k => energy alg xstar k) Filter.atTop (nhds E_inf) := by
  have hbounded : ∀ k, 0 ≤ energy alg xstar k := by
    intro k
    unfold energy
    have h1 : 0 ≤ ‖alg.x k - xstar‖ ^ 2 := sq_nonneg _
    have h2 : 0 ≤ (1/2 : ℝ) * ‖alg.x k - alg.x (k - 1)‖ ^ 2 := by positivity
    have hth : 0 ≤ theta alg.la k := by
      unfold theta; split_ifs
      · rfl
      · exact le_of_lt (div_pos (alg.la_pos k) (alg.la_pos (k - 1)))
    have hfx : 0 ≤ f (alg.x (k - 1)) - f xstar := by
      have h := hmin (mem_univ (alg.x (k - 1))); simpa using h
    have h3 : 0 ≤ 2 * alg.la k * theta alg.la k * (f (alg.x (k - 1)) - f xstar) :=
      mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) (alg.la_pos k).le) hth) hfx
    linarith
  have hg_anti : Antitone (fun k => energy alg xstar (k + 1)) := by
    intro i j hij
    induction j, hij using Nat.le_induction with
    | base => exact le_refl _
    | succ j _ ih => exact (energy_nonincreasing alg xstar hmin (j + 1) (by omega)).trans ih
  have hg_bdd : BddBelow (Set.range (fun k => energy alg xstar (k + 1))) := by
    refine ⟨0, fun y hy => ?_⟩
    obtain ⟨k, hk⟩ := hy
    have hbeta : (fun k => energy alg xstar (k + 1)) k = energy alg xstar (k + 1) := rfl
    rw [hbeta] at hk
    rw [← hk]
    exact hbounded (k + 1)
  have hg_tendsto := tendsto_atTop_ciInf hg_anti hg_bdd
  refine ⟨⨅ k, energy alg xstar (k + 1), ?_⟩
  rw [← Filter.tendsto_add_atTop_iff_nat 1]
  exact hg_tendsto

/-! ## Theorem 1 Part 3: Full Convergence via Opial Lemma -/

set_option linter.unusedSectionVars false in
/-- Energy difference equals norm difference when f(y) = f(z). -/
lemma energy_diff_eq_norm_diff (alg : AdGD f f') (y z : E) (k : ℕ) (hf_eq : f y = f z) :
    energy alg y k - energy alg z k = ‖alg.x k - y‖ ^ 2 - ‖alg.x k - z‖ ^ 2 := by
  unfold energy
  have : f (alg.x (k - 1)) - f y = f (alg.x (k - 1)) - f z := by rw [hf_eq]
  rw [this]
  ring

set_option linter.unusedSectionVars false in
/-- Two minimizers have the same function value. -/
lemma minimizers_same_value {y z : E} (hy : IsMinOn f Set.univ y) (hz : IsMinOn f Set.univ z) :
    f y = f z := by
  have h1 := hy (mem_univ z)
  have h2 := hz (mem_univ y)
  exact le_antisymm h1 h2

set_option linter.unusedSectionVars false in
/-- For minimizers y, z with energy limits E_y, E_z:
    if y is a cluster point, then E_z - E_y = ‖y - z‖². -/
theorem cluster_point_energy_identity (alg : AdGD f f')
    (y z : E) (hy_min : IsMinOn f Set.univ y) (hz_min : IsMinOn f Set.univ z)
    (E_y E_z : ℝ)
    (hEy : Filter.Tendsto (fun k => energy alg y k) Filter.atTop (nhds E_y))
    (hEz : Filter.Tendsto (fun k => energy alg z k) Filter.atTop (nhds E_z))
    (hy_cluster : MapClusterPt y Filter.atTop alg.x) :
    E_z - E_y = ‖y - z‖ ^ 2 := by
  have hf_eq : f y = f z := minimizers_same_value hy_min hz_min
  have hf_eq' : f z = f y := hf_eq.symm
  -- Energy difference converges to E_z - E_y
  have hdiff_tendsto : Filter.Tendsto (fun k => energy alg z k - energy alg y k) Filter.atTop
      (nhds (E_z - E_y)) := hEz.sub hEy
  obtain ⟨φ, hφ_mono, hφ_tendsto⟩ :=
    TopologicalSpace.FirstCountableTopology.tendsto_subseq hy_cluster
  have hφ_atTop : Filter.Tendsto φ Filter.atTop Filter.atTop :=
    hφ_mono.tendsto_atTop
  have htendsto_y : Filter.Tendsto (fun _ : ℕ => y) Filter.atTop (nhds y) :=
    tendsto_nhds.mpr fun _ _ ha => Filter.univ_mem' fun _ => ha
  have htendsto_z : Filter.Tendsto (fun _ : ℕ => z) Filter.atTop (nhds z) :=
    tendsto_nhds.mpr fun _ _ ha => Filter.univ_mem' fun _ => ha
  have hsub_y : Filter.Tendsto (fun j => alg.x (φ j) - y) Filter.atTop (nhds 0) := by
    simpa [sub_self] using hφ_tendsto.sub htendsto_y
  have hnorm_y : Filter.Tendsto (fun j => ‖alg.x (φ j) - y‖) Filter.atTop (nhds 0) := by
    simpa [norm_zero] using hsub_y.norm
  have hnorm_y_sq : Filter.Tendsto (fun j => ‖alg.x (φ j) - y‖ ^ 2) Filter.atTop (nhds 0) := by
    simpa [pow_two, norm_zero] using hnorm_y.mul hnorm_y
  have hsub_z : Filter.Tendsto (fun j => alg.x (φ j) - z) Filter.atTop (nhds (y - z)) :=
    hφ_tendsto.sub htendsto_z
  have hnorm_z : Filter.Tendsto (fun j => ‖alg.x (φ j) - z‖) Filter.atTop (nhds ‖y - z‖) :=
    hsub_z.norm
  have hnorm_z_sq : Filter.Tendsto (fun j => ‖alg.x (φ j) - z‖ ^ 2) Filter.atTop
      (nhds (‖y - z‖ ^ 2)) := by
    simpa [pow_two] using hnorm_z.mul hnorm_z
  have hrhs : Filter.Tendsto (fun j => ‖alg.x (φ j) - z‖ ^ 2 - ‖alg.x (φ j) - y‖ ^ 2)
      Filter.atTop (nhds (‖y - z‖ ^ 2)) := by
    simpa [sub_zero] using hnorm_z_sq.sub hnorm_y_sq
  have henergy_eq : ∀ j, energy alg z (φ j) - energy alg y (φ j) =
      ‖alg.x (φ j) - z‖ ^ 2 - ‖alg.x (φ j) - y‖ ^ 2 := fun j =>
    energy_diff_eq_norm_diff alg z y (φ j) hf_eq'
  have hsubseq_limit : Filter.Tendsto (fun j => energy alg z (φ j) - energy alg y (φ j))
      Filter.atTop (nhds (E_z - E_y)) := hdiff_tendsto.comp hφ_atTop
  have hsubseq_limit2 : Filter.Tendsto (fun j => energy alg z (φ j) - energy alg y (φ j))
      Filter.atTop (nhds (‖y - z‖ ^ 2)) := by
    simpa [henergy_eq] using hrhs
  exact tendsto_nhds_unique hsubseq_limit hsubseq_limit2

set_option linter.unusedSectionVars false in
/-- If y and z are both cluster points and both minimizers, then y = z. -/
theorem unique_cluster_point (alg : AdGD f f')
    (y z : E) (hy_min : IsMinOn f Set.univ y) (hz_min : IsMinOn f Set.univ z)
    (E_y E_z : ℝ)
    (hEy : Filter.Tendsto (fun k => energy alg y k) Filter.atTop (nhds E_y))
    (hEz : Filter.Tendsto (fun k => energy alg z k) Filter.atTop (nhds E_z))
    (hy_cluster : MapClusterPt y Filter.atTop alg.x)
    (hz_cluster : MapClusterPt z Filter.atTop alg.x) :
    y = z := by
  have h1 := cluster_point_energy_identity alg y z hy_min hz_min E_y E_z hEy hEz hy_cluster
  have h2 := cluster_point_energy_identity alg z y hz_min hy_min E_z E_y hEz hEy hz_cluster
  -- h1: E_z - E_y = ‖y - z‖²
  -- h2: E_y - E_z = ‖z - y‖²
  -- Adding: 0 = 2‖y - z‖²
  have h1_nn : 0 ≤ ‖y - z‖ ^ 2 := sq_nonneg _
  have hsum : 0 = ‖y - z‖ ^ 2 + ‖z - y‖ ^ 2 := by linarith [h1, h2]
  rw [norm_sub_rev] at hsum
  have hsq : ‖y - z‖ ^ 2 = 0 := by linarith
  have habs : ‖y - z‖ = 0 := by
    by_contra hne
    have hpos : 0 < ‖y - z‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hne)
    have : 0 < ‖y - z‖ ^ 2 := by positivity
    linarith
  exact sub_eq_zero.mp (norm_eq_zero.mp habs)

set_option linter.unusedSectionVars false in
/-- The sequence (x^k) converges to a minimizer (Theorem 1 part 3). -/
theorem full_convergence (alg : AdGD f f') (hr : MinStepsizeRule alg)
    (xstar : E) (hmin : IsMinOn f Set.univ xstar)
    (hloc : GradientLocallyLipschitz f') :
    ∃ x_lim : E, IsMinOn f Set.univ x_lim ∧
      Filter.Tendsto alg.x Filter.atTop (nhds x_lim) := by
  obtain ⟨R, hR_nn, hR⟩ := all_iterates_bounded alg xstar hmin
  have hproper : ProperSpace E := FiniteDimensional.proper ℝ E
  have hcompact : IsCompact (Metric.closedBall xstar R) := isCompact_closedBall xstar R
  have hin_ball : ∀ n, alg.x n ∈ Metric.closedBall xstar R := fun n =>
    Metric.mem_closedBall.2 (by rw [dist_eq_norm]; exact hR n)
  have hin_ball_eventually : ∀ᶠ n in Filter.atTop, alg.x n ∈ Metric.closedBall xstar R :=
    Filter.Eventually.of_forall hin_ball
  obtain ⟨E_star, hE_star⟩ := energy_limit_exists alg xstar hmin
  have hcluster_min : ∀ w ∈ Metric.closedBall xstar R,
    MapClusterPt w Filter.atTop alg.x → IsMinOn f Set.univ w := by
    intro w hw hw_cluster
    obtain ⟨φ, hφ_mono, hφ_tendsto⟩ := TopologicalSpace.FirstCountableTopology.tendsto_subseq hw_cluster
    exact cluster_point_is_minimizer alg hr xstar hmin hloc w ⟨φ, hφ_mono, hφ_tendsto⟩
  have hunique_cluster : ∀ w ∈ Metric.closedBall xstar R,
    MapClusterPt w Filter.atTop alg.x →
    ∀ w' ∈ Metric.closedBall xstar R,
      MapClusterPt w' Filter.atTop alg.x → w = w' := by
    intro w hw hw_cluster w' hw' hw'_cluster
    have hw_min : IsMinOn f Set.univ w := hcluster_min w hw hw_cluster
    have hw'_min : IsMinOn f Set.univ w' := hcluster_min w' hw' hw'_cluster
    obtain ⟨E_w, hE_w⟩ := energy_limit_exists alg w hw_min
    obtain ⟨E_w', hE_w'⟩ := energy_limit_exists alg w' hw'_min
    exact unique_cluster_point alg w w' hw_min hw'_min E_w E_w' hE_w hE_w' hw_cluster hw'_cluster
  have hfreq : ∃ᶠ n in Filter.atTop, alg.x n ∈ Metric.closedBall xstar R :=
    Filter.Frequently.of_forall hin_ball
  obtain ⟨y, hy_ball, hy_cluster⟩ :=
    hcompact.exists_mapClusterPt_of_frequently hfreq
  have hy_min : IsMinOn f Set.univ y := hcluster_min y hy_ball hy_cluster
  have hunique_y : ∀ w ∈ Metric.closedBall xstar R,
    MapClusterPt w Filter.atTop alg.x → w = y := by
    intro w hw hw_cluster
    exact hunique_cluster w hw hw_cluster y hy_ball hy_cluster
  have htendsto := hcompact.tendsto_nhds_of_unique_mapClusterPt hin_ball_eventually hunique_y
  exact ⟨y, hy_min, htendsto⟩

