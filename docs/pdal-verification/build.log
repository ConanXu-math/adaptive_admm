info: PDAL/AxiomCheck.lean:9:0: @pdal_main : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X] [inst_2 : CompleteSpace X]
  [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2} [inst_5 : NormedAddCommGroup Y]
  [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y] [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y]
  (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y) (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0)
  (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1) (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  Bornology.IsBounded (Set.range fun k ↦ (alg.x k, alg.y k)) ∧
    (∀ (xstar : X) (ystar : Y),
        IsClusterPoint (fun k ↦ (alg.x k, alg.y k)) (xstar, ystar) → IsSaddlePoint K g h xstar ystar) ∧
      (∃ xstar ystar, IsClusterPoint (fun k ↦ (alg.x k, alg.y k)) (xstar, ystar) ∧ IsSaddlePoint K g h xstar ystar) ∧
        ((ContinuousOn g.f g.dom ∧ ∃ M, ∀ (k : ℕ), alg.tau k ≤ M) →
          ∃ xstar ystar,
            IsSaddlePoint K g h xstar ystar ∧
              Filter.Tendsto (fun k ↦ alg.x k) Filter.atTop (nhds xstar) ∧
                Filter.Tendsto (fun k ↦ alg.y k) Filter.atTop (nhds ystar))
info: PDAL/AxiomCheck.lean:10:0: @pdal_main_rate : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  x0 ∈ g.dom →
    have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
    ∃ C,
      0 ≤ C ∧
        ∀ N ≥ 1,
          have s_N := ∑ k ∈ Finset.range N, alg.tau (k + 1);
          have X_N :=
            (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
              ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1));
          have Y_N := (1 / s_N) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2);
          pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤ C / ↑N
info: PDAL/AxiomCheck.lean:11:0: @pdal_main_ergodic : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  ∀ N ≥ 1,
    have s_N := ∑ k ∈ Finset.range N, alg.tau (k + 1);
    have X_N :=
      (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
        ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1));
    have Y_N := (1 / s_N) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2);
    X_N ∈ g.dom ∧
      Y_N ∈ h.dom ∧
        0 ≤ pd_gap K g h X_N Y_N sp.xhat sp.yhat ∧
          (x0 ∈ g.dom →
            pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤
              (‖alg.x 1 - sp.xhat‖ ^ 2 / 2 + ‖alg.y 1 - sp.yhat‖ ^ 2 / (2 * alg.beta) +
                  alg.tau 1 * alg.theta 1 * primal_gap K g (alg.x 0) sp.xhat sp.yhat) /
                s_N)
info: PDAL/AxiomCheck.lean:12:0: @pdal_bounded : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
