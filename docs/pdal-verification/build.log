    [inst_1 : InnerProductSpace ℝ X] →
      [inst_2 : CompleteSpace X] →
        [FiniteDimensional ℝ X] →
          [inst_4 : ProperSpace X] →
            {Y : Type u_2} →
              [inst_5 : NormedAddCommGroup Y] →
                [inst_6 : InnerProductSpace ℝ Y] →
                  [inst_7 : CompleteSpace Y] →
                    [inst_8 : FiniteDimensional ℝ Y] →
                      [inst_9 : ProperSpace Y] →
                        (K : X →L[ℝ] Y) →
                          (g : ProperConvex X) →
                            (h : ProperConvex Y) →
                              X →
                                Y →
                                  (tau0 : ℝ) →
                                    0 < tau0 →
                                      (mu delta beta : ℝ) →
                                        0 < mu ∧ mu < 1 →
                                          0 < delta ∧ delta < 1 →
                                            0 < beta →
                                              (sel : ℕ → ℝ → ℝ → ℝ) →
                                                (∀ (j : ℕ) (τ : ℝ),
                                                    0 < τ →
                                                      ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)) →
