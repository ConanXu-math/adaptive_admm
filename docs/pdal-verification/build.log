info: PDAL/AxiomCheck.lean:6:0: @mkPDAL_spec : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  (∀ k ≥ 1,
      prox_scale g (alg.tau (k - 1)) (alg.x (k - 1) - alg.tau (k - 1) • (ContinuousLinearMap.adjoint K) (alg.y k))
        (alg.x k)) ∧
    ∀ k ≥ 1, accept_cond K alg.beta alg.delta (alg.tau k) (alg.y k) (alg.y (k + 1))
