@mkPDAL : {X : Type u_1} →
  [inst : NormedAddCommGroup X] →
    [inst_1 : InnerProductSpace ℝ X] →
      [inst_2 : CompleteSpace X] →
        [FiniteDimensional ℝ X] →
          [inst_4 : ProperSpace X] →
            {Y : Type u_2} →
              [inst_5 : NormedAddCommGroup Y] →
                [inst_6 : InnerProductSpace ℝ Y] →
                  [inst_7 : CompleteSpace Y] →
                    [inst_8 : FiniteDimensional ℝ Y] →
                      [inst_9 : ProperSpace Y] →
                        (K : X →L[ℝ] Y) →
                          (g : ProperConvex X) →
                            (h : ProperConvex Y) →
                              X →
                                Y →
                                  (tau0 : ℝ) →
                                    0 < tau0 →
                                      (mu delta beta : ℝ) →
                                        0 < mu ∧ mu < 1 →
                                          0 < delta ∧ delta < 1 →
                                            0 < beta →
                                              (sel : ℕ → ℝ → ℝ → ℝ) →
                                                (∀ (j : ℕ) (τ : ℝ),
                                                    0 < τ →
                                                      ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)) →
                                                  PDAL K g h
@mkPDAL_spec : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  (∀ k ≥ 1,
      prox_scale g (alg.tau (k - 1)) (alg.x (k - 1) - alg.tau (k - 1) • (ContinuousLinearMap.adjoint K) (alg.y k))
        (alg.x k)) ∧
    ∀ k ≥ 1, accept_cond K alg.beta alg.delta (alg.tau k) (alg.y k) (alg.y (k + 1))
@mkPDAL_x0 : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X] [inst_2 : CompleteSpace X]
  [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2} [inst_5 : NormedAddCommGroup Y]
  [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y] [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y]
  (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y) (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0)
  (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1) (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)),
  (mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel).x 0 = x0
@mkPDAL_y0 : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X] [inst_2 : CompleteSpace X]
  [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2} [inst_5 : NormedAddCommGroup Y]
  [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y] [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y]
  (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y) (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0)
  (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1) (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ)),
  (mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel).y 0 = y1
@pdal_main : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X] [inst_2 : CompleteSpace X]
  [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2} [inst_5 : NormedAddCommGroup Y]
  [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y] [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y]
  (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y) (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0)
  (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1) (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  Bornology.IsBounded (Set.range fun k => (alg.x k, alg.y k)) ∧
    (∀ (xstar : X) (ystar : Y),
        IsClusterPoint (fun k => (alg.x k, alg.y k)) (xstar, ystar) → IsSaddlePoint K g h xstar ystar) ∧
      (∃ xstar ystar, IsClusterPoint (fun k => (alg.x k, alg.y k)) (xstar, ystar) ∧ IsSaddlePoint K g h xstar ystar) ∧
        ((ContinuousOn g.f g.dom ∧ ∃ M, ∀ (k : ℕ), alg.tau k ≤ M) →
          ∃ xstar ystar,
            IsSaddlePoint K g h xstar ystar ∧
              Filter.Tendsto (fun k => alg.x k) Filter.atTop (nhds xstar) ∧
                Filter.Tendsto (fun k => alg.y k) Filter.atTop (nhds ystar))
@pdal_main_rate : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  x0 ∈ g.dom →
    have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
    ∃ C,
      0 ≤ C ∧
        ∀ N ≥ 1,
          have s_N := ∑ k ∈ Finset.range N, alg.tau (k + 1);
          have X_N :=
            (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
              ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1));
          have Y_N := (1 / s_N) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2);
          pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤ C / ↑N
@pdal_main_ergodic : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [inst_3 : FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x0 : X) (y1 : Y) (tau0 : ℝ) (htau0 : 0 < tau0) (mu delta beta : ℝ) (hm : 0 < mu ∧ mu < 1)
  (hd : 0 < delta ∧ delta < 1) (hb : 0 < beta) (sel : ℕ → ℝ → ℝ → ℝ)
  (hsel : ∀ (j : ℕ) (τ : ℝ), 0 < τ → ∀ (θ : ℝ), 0 ≤ θ → sel j τ θ ≥ τ ∧ sel j τ θ ≤ τ * √(1 + θ))
  (sp : SaddlePoint K g h),
  have alg := mkPDAL K g h x0 y1 tau0 htau0 mu delta beta hm hd hb sel hsel;
  ∀ N ≥ 1,
    have s_N := ∑ k ∈ Finset.range N, alg.tau (k + 1);
    have X_N :=
      (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
        ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1));
    have Y_N := (1 / s_N) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2);
    X_N ∈ g.dom ∧
      Y_N ∈ h.dom ∧
        0 ≤ pd_gap K g h X_N Y_N sp.xhat sp.yhat ∧
          (x0 ∈ g.dom →
            pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤
              (‖alg.x 1 - sp.xhat‖ ^ 2 / 2 + ‖alg.y 1 - sp.yhat‖ ^ 2 / (2 * alg.beta) +
                  alg.tau 1 * alg.theta 1 * primal_gap K g (alg.x 0) sp.xhat sp.yhat) /
                s_N)
@pdal_bounded : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h), Bornology.IsBounded (Set.range fun k => (alg.x k, alg.y k))
@pdal_cluster_point_saddle : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h) (xstar : X) (ystar : Y),
  IsClusterPoint (fun k => (alg.x k, alg.y k)) (xstar, ystar) → IsSaddlePoint K g h xstar ystar
@pdal_has_saddle_cluster_point : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h),
  ∃ xstar ystar, IsClusterPoint (fun k => (alg.x k, alg.y k)) (xstar, ystar) ∧ IsSaddlePoint K g h xstar ystar
@pdal_convergence : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h),
  ContinuousOn g.f g.dom →
    (∃ M, ∀ (k : ℕ), alg.tau k ≤ M) →
      ∃ xstar ystar,
        IsSaddlePoint K g h xstar ystar ∧
          Filter.Tendsto (fun k => alg.x k) Filter.atTop (nhds xstar) ∧
            Filter.Tendsto (fun k => alg.y k) Filter.atTop (nhds ystar)
@pdal_ergodic_dom : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (N : ℕ),
  1 ≤ N →
    (1 / (alg.tau 1 * alg.theta 1 + ∑ k ∈ Finset.range N, alg.tau (k + 1))) •
          ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1)) ∈
        g.dom ∧
      (1 / ∑ k ∈ Finset.range N, alg.tau (k + 1)) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2) ∈ h.dom
@pdal_ergodic_rate : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h),
  alg.x 0 ∈ g.dom →
    ∀ N ≥ 1,
      have s_N := List.foldl (fun acc k => acc + alg.tau (k + 1)) 0 (List.range N);
      have X_N :=
        (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
          ((alg.tau 1 * alg.theta 1) • alg.x 0 +
            List.foldl (fun acc k => acc + alg.tau (k + 1) • xbar alg (k + 1)) 0 (List.range N));
      have Y_N := (1 / s_N) • List.foldl (fun acc k => acc + alg.tau (k + 1) • alg.y (k + 2)) 0 (List.range N);
      pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤
        1 / s_N *
          (‖alg.x 1 - sp.xhat‖ ^ 2 / 2 + ‖alg.y 1 - sp.yhat‖ ^ 2 / (2 * alg.beta) +
            alg.tau 1 * alg.theta 1 * primal_gap K g (alg.x 0) sp.xhat sp.yhat)
@pdal_ergodic_rate_O1 : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h),
  alg.x 0 ∈ g.dom →
    ∃ C,
      0 ≤ C ∧
        ∀ N ≥ 1,
          have s_N := ∑ k ∈ Finset.range N, alg.tau (k + 1);
          have X_N :=
            (1 / (alg.tau 1 * alg.theta 1 + s_N)) •
              ((alg.tau 1 * alg.theta 1) • alg.x 0 + ∑ k ∈ Finset.range N, alg.tau (k + 1) • xbar alg (k + 1));
          have Y_N := (1 / s_N) • ∑ k ∈ Finset.range N, alg.tau (k + 1) • alg.y (k + 2);
          pd_gap K g h X_N Y_N sp.xhat sp.yhat ≤ C / ↑N
@tau_lower_bound : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h), ∃ τ_min, 0 < τ_min ∧ ∀ (k : ℕ), τ_min ≤ alg.tau k
@theta_upper_bound : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (k : ℕ), alg.theta k ≤ theta_bound
@energy_inequality : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] {K : X →L[ℝ] Y} {g : ProperConvex X} {h : ProperConvex Y}
  (alg : PDAL K g h) (sp : SaddlePoint K g h),
  ∀ k ≥ 1,
    alg.x (k - 1) ∈ g.dom →
      ‖alg.x (k + 1) - sp.xhat‖ ^ 2 / 2 + ‖alg.y (k + 1) - sp.yhat‖ ^ 2 / (2 * alg.beta) +
          alg.tau k * (1 + alg.theta k) * primal_gap K g (alg.x k) sp.xhat sp.yhat ≤
        ‖alg.x k - sp.xhat‖ ^ 2 / 2 + ‖alg.y k - sp.yhat‖ ^ 2 / (2 * alg.beta) +
              alg.tau (k - 1) * (1 + alg.theta (k - 1)) * primal_gap K g (alg.x (k - 1)) sp.xhat sp.yhat -
            ‖xbar alg k - alg.x k‖ ^ 2 / 2 -
          (1 - alg.delta ^ 2) * ‖alg.y (k + 1) - alg.y k‖ ^ 2 / (2 * alg.beta)
@linesearch_terminates : ∀ {X : Type u_1} [inst : NormedAddCommGroup X] [inst_1 : InnerProductSpace ℝ X]
  [inst_2 : CompleteSpace X] [FiniteDimensional ℝ X] [inst_4 : ProperSpace X] {Y : Type u_2}
  [inst_5 : NormedAddCommGroup Y] [inst_6 : InnerProductSpace ℝ Y] [inst_7 : CompleteSpace Y]
  [inst_8 : FiniteDimensional ℝ Y] [inst_9 : ProperSpace Y] (K : X →L[ℝ] Y) (g : ProperConvex X) (h : ProperConvex Y)
  (x_k x_km1 : X) (y_k : Y) (tau_km1 tau_trial beta delta mu : ℝ),
  0 < tau_km1 →
    ∀ (h_tau_trial : 0 < tau_trial) (h_beta : 0 < beta),
      0 < delta →
        ∀ (h_mu : 0 < mu ∧ mu < 1),
          ∃ i,
            0 < tau_trial * mu ^ i ∧
              accept_cond K beta delta (tau_trial * mu ^ i) y_k
                (prox h (beta * (tau_trial * mu ^ i)) ⋯
                  (y_k + (beta * (tau_trial * mu ^ i)) • K (x_k + (tau_trial * mu ^ i / tau_km1) • (x_k - x_km1))))
@min_accept_index : {X : Type u_1} →
  [inst : NormedAddCommGroup X] →
    [inst_1 : InnerProductSpace ℝ X] →
      [inst_2 : CompleteSpace X] →
        [FiniteDimensional ℝ X] →
          [inst_4 : ProperSpace X] →
            {Y : Type u_2} →
              [inst_5 : NormedAddCommGroup Y] →
                [inst_6 : InnerProductSpace ℝ Y] →
                  [inst_7 : CompleteSpace Y] →
                    [FiniteDimensional ℝ Y] →
                      [inst_9 : ProperSpace Y] →
                        (X →L[ℝ] Y) →
                          ProperConvex X →
                            ProperConvex Y →
                              X →
                                X →
                                  Y →
                                    (tau_km1 tau_trial beta delta mu : ℝ) →
                                      0 < tau_km1 → 0 < tau_trial → 0 < beta → 0 < delta → 0 < mu ∧ mu < 1 → ℕ
@prox_scale_exists : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] [FiniteDimensional ℝ E] [inst_4 : ProperSpace E] (G : ProperConvex E) {τ : ℝ},
  0 < τ → ∀ (x : E), ∃ z, prox_scale G τ x z
@prox_scale_unique : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] [FiniteDimensional ℝ E] [inst_4 : ProperSpace E] (G : ProperConvex E) {τ : ℝ},
  0 < τ → ∀ (x : E) {z₁ z₂ : E}, prox_scale G τ x z₁ → prox_scale G τ x z₂ → z₁ = z₂
@prox_scale_optimality : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  [inst_2 : CompleteSpace E] [FiniteDimensional ℝ E] [inst_4 : ProperSpace E] (G : ProperConvex E) {τ : ℝ},
  0 < τ →
    ∀ (x : E) {zbar : E}, prox_scale G τ x zbar → ∀ y ∈ G.dom, inner ℝ (zbar - x) (y - zbar) ≥ τ * (G.f zbar - G.f y)
